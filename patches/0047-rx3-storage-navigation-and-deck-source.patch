diff --git a/src/widget/wrx3decksource.h b/src/widget/wrx3decksource.h
new file mode 100644
index 0000000..a209cf9
--- /dev/null
+++ b/src/widget/wrx3decksource.h
@@ -0,0 +1,40 @@
+#pragma once
+
+#include <QTimer>
+
+#include "mixer/playerinfo.h"
+#include "skin/legacy/skincontext.h"
+#include "widget/wlabel.h"
+#include "widget/wrx3browser.h"
+
+// Deck source readout in the waveform info column: USBn for exported
+// rekordbox media, STORAGE for tracks from the local Mixxx library.
+class WRx3DeckSource : public WLabel {
+  public:
+    explicit WRx3DeckSource(QWidget* parent = nullptr) : WLabel(parent) {}
+    void setup(const QDomNode& node, const SkinContext& context) override {
+        WLabel::setup(node, context);
+        m_group = QStringLiteral("[Channel%1]").arg(context.selectString(node, "Channel").toInt());
+        connect(&PlayerInfo::instance(), &PlayerInfo::trackChanged, this,
+                [this](const QString& group, TrackPointer, TrackPointer) {
+                    if (group == m_group) refresh();
+                });
+        QTimer::singleShot(0, this, [this] { refresh(); });
+    }
+
+  private:
+    void refresh() {
+        const auto track = PlayerInfo::instance().getTrackInfo(m_group);
+        QString text;
+        if (track) {
+            auto* canvas = window();
+            auto* browser = canvas ? static_cast<WRx3Browser*>(canvas->findChild<QWidget*>("RX3NativeBrowser")) : nullptr;
+            if (browser) text = browser->deckSourceName(track->getLocation());
+        }
+        setText(text);
+        if (auto* icon = parentWidget() ? parentWidget()->findChild<QWidget*>("WaveformInfoUsbIcon") : nullptr) {
+            icon->setVisible(text.startsWith(QStringLiteral("USB")));
+        }
+    }
+    QString m_group;
+};
