+void MixxxMainWindow::rx3SizeWindowToSkin() {
+    const bool rx3 = rx3ui::isRx3Skin(m_pCoreServices->getSettings()->getValueString(
+            ConfigKey("[Config]", "ResizableSkin")));
+    if (!rx3 || isFullScreen()) {
