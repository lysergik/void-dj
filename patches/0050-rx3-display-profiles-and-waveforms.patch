+// Queues background waveform analysis for local-library tracks that have no
+// stored waveform summary yet (STORAGE thumbnails read the stored summary).
+inline int WRx3Browser::queueMissingWaveforms() {
+    if(!m_backend || !m_backend->trackCollectionManager() ||
+            !m_backend->trackCollectionManager()->internalCollection()) return 0;
+    QSqlQuery query(m_backend->trackCollectionManager()->internalCollection()->database());
+    QList<AnalyzerScheduledTrack> tracks;
+    if(query.exec(QStringLiteral("SELECT l.id FROM library l JOIN track_locations t ON l.location=t.id "
+            "WHERE l.mixxx_deleted=0 AND t.fs_deleted=0 AND l.id NOT IN "
+            "(SELECT track_id FROM track_analysis WHERE type=%1)").arg(int(AnalysisDao::TYPE_WAVESUMMARY)))) {
+        while(query.next()) tracks.append(AnalyzerScheduledTrack(TrackId(query.value(0))));
+    }
+    if(!tracks.isEmpty()) emit m_backend->analyzeTracks(tracks);
+    return tracks.size();
+}
