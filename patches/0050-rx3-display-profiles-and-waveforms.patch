diff --git a/src/widget/rx3ui.h b/src/widget/rx3ui.h
new file mode 100644
index 0000000..904a815
--- /dev/null
+++ b/src/widget/rx3ui.h
@@ -0,0 +1,82 @@
+#pragma once
+
+#include <QRegularExpression>
+#include <QSize>
+#include <QString>
+#include <QtGlobal>
+#include <cmath>
+
+// Display profiles of NauticMixxx. The 1280x800 skin is the master design;
+// smaller skins declare <Rx3UiScale> (their density relative to the master)
+// and every native RX3 widget derives its fixed lengths from it, so the
+// same code serves all screen sizes.
+namespace rx3ui {
+
+struct Profile {
+    const char* skin;
+    int width;
+    int height;
+    const char* label;
+};
+
+inline constexpr Profile kProfiles[] = {
+        {"XDJ_RX3_Mixxx", 1280, 800, "1280x800"},
+        {"XDJ_RX3_Mixxx_800x600", 800, 600, "800x600"},
+        {"XDJ_RX3_Mixxx_600x480", 600, 480, "600x480"},
+        {"XDJ_RX3_Mixxx_480x320", 480, 320, "480x320"},
+};
+inline constexpr int kProfileCount = int(sizeof(kProfiles) / sizeof(kProfiles[0]));
+
+inline int profileIndexForSkin(const QString& skin) {
+    for (int i = 0; i < kProfileCount; ++i) {
+        if (skin == QLatin1String(kProfiles[i].skin)) return i;
+    }
+    return -1;
+}
+inline bool isRx3Skin(const QString& skin) { return profileIndexForSkin(skin) >= 0; }
+// Native size of an RX3 skin (invalid for any other skin).
+inline QSize skinSize(const QString& skin) {
+    const int index = profileIndexForSkin(skin);
+    return index < 0 ? QSize() : QSize(kProfiles[index].width, kProfiles[index].height);
+}
+
+inline double& densityRef() {
+    static double value = 1.0;
+    return value;
+}
+inline double density() { return densityRef(); }
+inline void setDensity(double value) {
+    densityRef() = std::isfinite(value) ? qBound(0.25, value, 2.0) : 1.0;
+}
+inline bool compact() { return density() < 0.85; }
+// A length (spacing, height, width) at the current density; never below 1px.
+inline int S(int value) { return qMax(1, qRound(value * density())); }
+// Text size at the current density, with a legibility floor.
+inline int F(int value, int floor = 9) {
+    if (density() < 0.5) floor = qMin(floor, 7);
+    return qMax(floor, qRound(value * qMax(density(), 0.55)));
+}
+
+// Rescales every pixel length in a stylesheet fragment to the current skin
+// density (text keeps a legibility floor). Identity at density 1.
+inline QString qss(const QString& style) {
+    if (qFuzzyCompare(density(), 1.0)) return style;
+    static const QRegularExpression px(QStringLiteral("(font(?:-size)?:\\s*(?:(?:bold|italic|normal)\\s+)*)?(-?\\d+(?:\\.\\d+)?)px"));
+    QString out;
+    qsizetype last = 0;
+    auto it = px.globalMatch(style);
+    while (it.hasNext()) {
+        const auto m = it.next();
+        out += style.mid(last, m.capturedStart() - last);
+        const int value = qRound(m.captured(2).toDouble());
+        if (m.capturedLength(1) > 0) {
+            out += m.captured(1) + QString::number(F(value)) + QStringLiteral("px");
+        } else {
+            out += QString::number(value == 0 ? 0 : S(value)) + QStringLiteral("px");
+        }
+        last = m.capturedEnd();
+    }
+    return out + style.mid(last);
+}
+
+} // namespace rx3ui
