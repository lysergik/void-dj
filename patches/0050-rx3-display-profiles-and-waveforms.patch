+
+void MixxxMainWindow::setupRx3DisplayControls() {
+    if (m_pRx3Fullscreen) {
+        return;
+    }
+    const auto pConfig = m_pCoreServices->getSettings();
+    m_pRx3Fullscreen = new ControlObject(
+            ConfigKey("[RX3Window]", "fullscreen"), false, false, false, isFullScreen() ? 1 : 0);
+    m_pRx3ApplyResolution = new ControlObject(
+            ConfigKey("[RX3Window]", "apply_resolution"), false, false, false, 0);
+    auto* fullscreen = new ControlProxy(ConfigKey("[RX3Window]", "fullscreen"), this);
+    fullscreen->connectValueChanged(this, [this](double value) {
+        // Never change the window while one of its own widgets is still on
+        // the call stack of the request.
+        QTimer::singleShot(0, this, [this, value] {
+            m_pCoreServices->getSettings()->setValue(
+                    ConfigKey("[RX3Window]", "LastFullscreen"), value > 0.5);
+            slotViewFullScreen(value > 0.5);
+            if (value <= 0.5) {
+                QTimer::singleShot(50, this, [this] { rx3SizeWindowToSkin(); });
+            }
+        });
+    });
+    auto* apply = new ControlProxy(ConfigKey("[RX3Window]", "apply_resolution"), this);
+    apply->connectValueChanged(this, [this](double value) {
+        if (value > 0.5) {
+            QTimer::singleShot(0, this, [this] { rx3ApplyResolution(); });
+        }
+    });
+    Q_UNUSED(pConfig);
+}
+
+void MixxxMainWindow::rx3ApplyResolution() {
+    const auto pConfig = m_pCoreServices->getSettings();
+    const int index = pConfig->getValue<int>(ConfigKey("[RX3Window]", "Resolution"), 0);
+    if (index < 0 || index >= rx3ui::kProfileCount) {
+        return;
+    }
+    const QString skin = QString::fromLatin1(rx3ui::kProfiles[index].skin);
+    if (pConfig->getValueString(ConfigKey("[Config]", "ResizableSkin")) != skin) {
+        pConfig->set(ConfigKey("[Config]", "ResizableSkin"), ConfigValue(skin));
+        pConfig->set(ConfigKey("[Config]", "Skin"), ConfigValue(skin));
+        pConfig->save();
+        rebootMixxxView();
+    }
+    // The rebuilt skin needs a moment to lay out before the window is fitted.
+    QTimer::singleShot(200, this, [this] { rx3SizeWindowToSkin(); });
+}
