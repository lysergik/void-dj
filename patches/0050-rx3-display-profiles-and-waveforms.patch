+
+// Waveform styles offered by NauticMixxx (patch 0050): every stock Mixxx
+// renderer that is not deprecated or developer-only. The OpenGL "all-shader"
+// family is listed first; availability on the running system is decided by
+// WaveformWidgetFactory::getAvailableTypes().
+inline bool selectableWaveformType(WaveformWidgetType::Type type) {
+    switch (type) {
+    case WaveformWidgetType::AllShaderSimpleWaveform:
+    case WaveformWidgetType::AllShaderFilteredWaveform:
+    case WaveformWidgetType::AllShaderRGBWaveform:
+    case WaveformWidgetType::AllShaderLRRGBWaveform:
+    case WaveformWidgetType::AllShaderRGBStackedWaveform:
+    case WaveformWidgetType::AllShaderHSVWaveform:
+    case WaveformWidgetType::AllShaderTexturedFiltered:
+    case WaveformWidgetType::AllShaderTexturedRGB:
+    case WaveformWidgetType::AllShaderTexturedStacked:
+    case WaveformWidgetType::SoftwareSimpleWaveform:
+    case WaveformWidgetType::SoftwareWaveform:
+    case WaveformWidgetType::RGBWaveform:
+    case WaveformWidgetType::HSVWaveform:
+    case WaveformWidgetType::QtSimpleWaveform:
+    case WaveformWidgetType::QtWaveform:
+    case WaveformWidgetType::QtRGBWaveform:
+    case WaveformWidgetType::QtHSVWaveform:
+        return true;
+    default:
+        return false;
+    }
+}
+// Short, touch-friendly name; empty when the type is not offered.
+inline QString waveformTypeLabel(WaveformWidgetType::Type type) {
+    switch (type) {
+    case WaveformWidgetType::AllShaderSimpleWaveform: return QStringLiteral("SIMPLE");
+    case WaveformWidgetType::AllShaderFilteredWaveform: return QStringLiteral("FILTERED");
+    case WaveformWidgetType::AllShaderRGBWaveform: return QStringLiteral("RGB");
+    case WaveformWidgetType::AllShaderLRRGBWaveform: return QStringLiteral("L/R RGB");
+    case WaveformWidgetType::AllShaderRGBStackedWaveform: return QStringLiteral("STACKED");
+    case WaveformWidgetType::AllShaderHSVWaveform: return QStringLiteral("HSV");
+    case WaveformWidgetType::AllShaderTexturedFiltered: return QStringLiteral("TEXTURED FILTERED");
+    case WaveformWidgetType::AllShaderTexturedRGB: return QStringLiteral("TEXTURED RGB");
+    case WaveformWidgetType::AllShaderTexturedStacked: return QStringLiteral("TEXTURED STACKED");
+    case WaveformWidgetType::SoftwareSimpleWaveform: return QStringLiteral("SOFTWARE SIMPLE");
+    case WaveformWidgetType::SoftwareWaveform: return QStringLiteral("SOFTWARE FILTERED");
+    case WaveformWidgetType::RGBWaveform: return QStringLiteral("SOFTWARE RGB");
+    case WaveformWidgetType::HSVWaveform: return QStringLiteral("SOFTWARE HSV");
+    case WaveformWidgetType::QtSimpleWaveform: return QStringLiteral("QT SIMPLE");
+    case WaveformWidgetType::QtWaveform: return QStringLiteral("QT FILTERED");
+    case WaveformWidgetType::QtRGBWaveform: return QStringLiteral("QT RGB");
+    case WaveformWidgetType::QtHSVWaveform: return QStringLiteral("QT HSV");
+    default: return QString();
+    }
+}
+
 // Same small, upward-pointing marker in detail waveforms and deck overviews.
 inline QRectF positionTriangleRect(qreal x, qreal bottom, qreal scale = 1) {
     return QRectF(x - 4 * scale, bottom - 7 * scale, 8 * scale, 7 * scale);
