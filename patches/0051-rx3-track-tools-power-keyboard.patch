@@ -0,0 +1,174 @@
+#pragma once
+
+#include <QApplication>
+#include <QKeyEvent>
+#include <QLineEdit>
+#include <QObject>
+#include <QPlainTextEdit>
+#include <QPointer>
+#include <QTextEdit>
+#include <QWidget>
+
+#include "control/controlobject.h"
+
+// Keyboard layer of the RX3 skins (patch 0051). It mirrors the controller
+// gestures of the DDJ presets so the whole interface can be driven without a
+// controller. Keys are handled only for the main window (not for dialogs, and
+// without needing a window manager to report focus), so
+// Preferences and other dialogs keep their own Return/Escape behaviour, and
+// text fields keep Backspace/Left/Right.
+//
+//   Up / Down            BROWSE turn           Shift+Up/Down (or Shift+Left/Right)
+//   Return / Enter       BROWSE press                          step the header
+//   Backspace            BACK                  F1  SOURCE
+//   Shift+Return         BACK                  F2  BROWSE <-> PERFORMANCE
+//   Escape               close SHORTCUT / BACK F3  SHORTCUT
+//   F4  TRACK TOOLS      F5  UTILITY (MENU)    F6  GRID on/off
+//   F7  TAG LIST         F8  PLAYLIST          F9  SEARCH
+//   F10 POWER            Ctrl+1..4 LOAD to deck 1..4
+class WRx3Keyboard : public QObject {
+  public:
+    explicit WRx3Keyboard(QWidget* canvas) : QObject(canvas), m_canvas(canvas) {
+        qApp->installEventFilter(this);
+    }
+    ~WRx3Keyboard() override {
+        if(qApp) qApp->removeEventFilter(this);
+    }
+
+  protected:
+    bool eventFilter(QObject* watched, QEvent* event) override {
+        if(event->type()!=QEvent::KeyPress || !m_canvas) return false;
+        auto* widget=qobject_cast<QWidget*>(watched);
+        if(!widget || widget->window()!=m_canvas->window()) return false;
+        auto* key=static_cast<QKeyEvent*>(event);
+        const bool typing=qobject_cast<QLineEdit*>(QApplication::focusWidget()) ||
+                qobject_cast<QTextEdit*>(QApplication::focusWidget()) ||
+                qobject_cast<QPlainTextEdit*>(QApplication::focusWidget());
+        const auto mods=key->modifiers()&~Qt::KeypadModifier;
+        const bool shift=mods==Qt::ShiftModifier,plain=mods==Qt::NoModifier,ctrl=mods==Qt::ControlModifier;
+        const int code=key->key();
+        if(key->isAutoRepeat() && !(code==Qt::Key_Up || code==Qt::Key_Down)) return false;
+        if(plain) {
+            switch(code) {
+            case Qt::Key_Up: turn(-1);return true;
+            case Qt::Key_Down: turn(1);return true;
+            case Qt::Key_Return: case Qt::Key_Enter: press();return true;
+            case Qt::Key_Backspace: if(typing) return false;back();return true;
+            case Qt::Key_Escape: escape();return true;
+            case Qt::Key_F1: source();return true;
+            case Qt::Key_F2: view();return true;
+            case Qt::Key_F3: pulse("[RX3Shortcut]","toggle");return true;
+            case Qt::Key_F4: header("track_tools");return true;
+            case Qt::Key_F5: header("utility");return true;
+            case Qt::Key_F6: grid();return true;
+            case Qt::Key_F7: header("tag_list");return true;
+            case Qt::Key_F8: header("playlist");return true;
+            case Qt::Key_F9: header("search");return true;
+            case Qt::Key_F10: power();return true;
+            default: return false;
+            }
+        }
+        if(shift) {
+            switch(code) {
+            case Qt::Key_Up: case Qt::Key_Left: step(-1);return true;
+            case Qt::Key_Down: case Qt::Key_Right: step(1);return true;
+            case Qt::Key_Return: case Qt::Key_Enter: back();return true;
+            default: return false;
+            }
+        }
+        if(ctrl && code>=Qt::Key_1 && code<=Qt::Key_4) {
+            const auto group=QString("[Channel%1]").arg(code-Qt::Key_0).toLatin1();
+            pulse(group.constData(),"LoadSelectedTrack");return true;
+        }
+        return false;
+    }
+
+  private:
+    static double get(const char* group,const char* item) {return ControlObject::get(ConfigKey(group,item));}
+    static void set(const char* group,const char* item,double value) {
+        if(ControlObject::exists(ConfigKey(group,item))) ControlObject::set(ConfigKey(group,item),value);
+    }
+    static void pulse(const char* group,const char* item,double value=1) {
+        if(!ControlObject::exists(ConfigKey(group,item))) return;
+        ControlObject::set(ConfigKey(group,item),value);ControlObject::set(ConfigKey(group,item),0);
+    }
+    static bool browserOpen() {return qRound(get("[Tab]","current"))==1;}
+    static bool shortcutVisible() {return get("[RX3Shortcut]","visible")>0;}
+    static bool infoVisible() {return get("[RX3Info]","visible")>0;}
+    // Same sequence as the controller scripts' open().
+    static bool openBrowser() {
+        if(browserOpen()) return false;
+        set("[XDJ_RX3]","search_active",0);set("[Tab]","library",1);set("[Skin]","show_maximized_library",1);
+        pulse("[RX3Browser]","open");
+        return true;
+    }
+    void turn(int direction) {
+        if(infoVisible()) {pulse("[RX3Info]","move",direction);return;}
+        if(shortcutVisible()) {pulse("[RX3Shortcut]","move",direction);return;}
+        if(get("[RX3Controller]","grid_mode")>0) {
+            const int deck=qRound(get("[RX3Controller]","active_deck"))==2?2:1;
+            const auto group=QString("[Channel%1]").arg(deck).toLatin1();
+            set(group.constData(),"beats_translate_move",direction);return;
+        }
+        if(browserOpen()) pulse("[RX3Browser]","move",direction);
+    }
+    void press() {
+        if(infoVisible()) {pulse("[RX3Info]","enter");return;}
+        if(shortcutVisible()) {pulse("[RX3Shortcut]","enter");return;}
+        if(get("[RX3Controller]","grid_mode")>0) {set("[RX3Controller]","grid_mode",0);return;}
+        if(!openBrowser()) pulse("[RX3Browser]","enter");
+    }
+    void back() {
+        if(shortcutVisible() || infoVisible()) return;
+        if(browserOpen()) pulse("[RX3Browser]","back");
+    }
+    void escape() {
+        if(shortcutVisible()) {pulse("[RX3Shortcut]","toggle");return;}
+        if(get("[RX3Controller]","grid_mode")>0) {set("[RX3Controller]","grid_mode",0);return;}
+        back();
+    }
+    void grid() {
+        if(browserOpen()) return;
+        set("[RX3Controller]","grid_mode",get("[RX3Controller]","grid_mode")>0?0:1);
+    }
+    void source() {
+        m_section=0;
+        if(shortcutVisible()) {pulse("[RX3Shortcut]","toggle");return;}
+        openBrowser();pulse("[RX3Browser]","source");
+    }
+    void view() {
+        m_section=-1;
+        if(shortcutVisible()) pulse("[RX3Shortcut]","toggle");
+        if(openBrowser()) return;
+        set("[Skin]","show_maximized_library",0);set("[Tab]","overview",1);
+    }
+    void power() {
+        if(infoVisible()) return;
+        if(shortcutVisible()) pulse("[RX3Shortcut]","toggle");
+        openBrowser();
+        pulse("[RX3Browser]","power");m_section=5;
+    }
+    void header(const char* name) {
+        if(shortcutVisible() || infoVisible()) return;
+        openBrowser();
+        pulse("[RX3Browser]",name);
+        for(int i=0;i<kSections;++i) if(qstrcmp(name,kSection[i])==0) m_section=i;
+    }
+    // SHIFT+turn on the controllers: SOURCE, BROWSE, TAG LIST, PLAYLIST,
+    // SEARCH, MENU, then TRACK TOOLS.
+    void step(int direction) {
+        if(shortcutVisible() || infoVisible()) return;
+        const bool wasClosed=openBrowser();
+        int next=wasClosed?0:(m_section<0?1:m_section+direction);
+        next=qBound(0,next,kSections-1);
+        if(next==m_section && !wasClosed) return;
+        // UTILITY and TRACK TOOLS are toggled/stacked pages: leave them first.
+        if(m_section>=5 && next!=m_section) pulse("[RX3Browser]","close_tools");
+        m_section=next;
+        pulse("[RX3Browser]",kSection[next]);
+    }
+    static constexpr int kSections=7;
+    static constexpr const char* kSection[kSections]={"source","browse","tag_list","playlist","search","utility","track_tools"};
+    QPointer<QWidget> m_canvas;
+    int m_section=-1;
+};
