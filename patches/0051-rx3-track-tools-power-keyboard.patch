+// TRACK TOOLS: crate, playlist, BPM and colour edits of one track, and POWER.
+// Both are ordinary UTILITY tool pages, so every action follows the shared
+// encoder contract (turn selects, press executes, hold = back) and is also
+// reachable from the keyboard and controller mappings through the
+// [RX3Browser],track_tools and [RX3Browser],power controls.
+
+// The track the tools act on: a deck chosen in the TARGET row, else the track
+// selected in the browser when TRACK TOOLS was opened, else the active deck.
+inline TrackPointer WRx3Browser::toolTarget() const {
+    const auto deckTrack=[](int deck) {
+        return PlayerInfo::instance().getTrackInfo(QString("[Channel%1]").arg(deck));
+    };
+    if(m_trackToolDeck>0) return deckTrack(m_trackToolDeck);
+    if(m_toolTrack) return m_toolTrack;
+    return deckTrack(qRound(ControlObject::get(ConfigKey("[RX3Controller]","active_deck")))==2?2:1);
+}
+
+inline QString WRx3Browser::toolTargetLabel() const {
+    const auto track=toolTarget();
+    QString who=m_trackToolDeck>0?QString("DECK %1").arg(m_trackToolDeck):
+            (m_toolTrack?QString("SELECTED"):QString("ACTIVE DECK"));
+    QString name=track?track->getTitle():QString();
+    if(track && name.isEmpty()) name=track->getFileInfo().fileName();
+    if(name.size()>38) name=name.left(37)+QStringLiteral("…");
+    return QString("TARGET (%1): %2").arg(who,name.isEmpty()?QStringLiteral("NONE"):name);
+}
+
+// Empty when the target may be edited, else the reason it may not.
+inline QString WRx3Browser::trackEditBlocked() const {
+    const auto track=toolTarget();
+    if(!track) return QStringLiteral("No track: select one in BROWSE or load a deck.");
+    if(!track->getUsePolicy().canPersist()) return QStringLiteral("USB tracks are read-only. Use TAG LIST for USB tracks.");
+    return {};
+}
+
+inline bool WRx3Browser::confirmed(const QString& id) {
+    if(m_confirmId==id && m_confirmClock.isValid() && m_confirmClock.elapsed()<4000) {
+        m_confirmId.clear();return true;
+    }
+    m_confirmId=id;m_confirmClock.restart();return false;
+}
+
+inline void WRx3Browser::showTrackTools() {
+    showUtility();
+    openUtilityTools("TRACK TOOLS",[this]{showTrackToolsMenu();});
+}
+
+inline void WRx3Browser::showTrackToolsMenu() {
+    std::vector<ToolAction> actions;
+    ToolAction target;
+    target.label=[this]{return toolTargetLabel();};
+    target.execute=[]{};
+    target.adjust=[this](int delta){m_trackToolDeck=((m_trackToolDeck+delta)%3+3)%3;};
+    actions.push_back(std::move(target));
+    actions.push_back(toolAction("ADD TO CRATE  ›",[this]{showTrackCrateMenu();}));
+    actions.push_back(toolAction("ADD TO PLAYLIST  ›",[this]{showTrackPlaylistMenu();}));
+    actions.push_back(toolAction("BPM  ›",[this]{showTrackBpmMenu();}));
+    actions.push_back(toolAction("COLOR  ›",[this]{showTrackColorMenu();}));
+    m_tools->showMenu("TRACK TOOLS",std::move(actions),[this]{showUtility();});
+    m_tools->message("Press TARGET, then turn to pick SELECTED / DECK 1 / DECK 2.");
+}
+
+inline void WRx3Browser::showTrackCrateMenu() {
+    const QString blocked=trackEditBlocked();
+    if(!storageCollection() || !blocked.isEmpty()) {m_tools->message(blocked.isEmpty()?QStringLiteral("STORAGE is unavailable."):blocked);return;}
+    showStorageCrateTools([this]{showTrackToolsMenu();});
+}
+
+inline QString WRx3Browser::toggleTrackPlaylist(int playlistId) {
+    auto* collection=storageCollection();const auto track=toolTarget();
+    if(!collection || !track || !track->getId().isValid()) return QStringLiteral("Select a STORAGE track first.");
+    auto& dao=collection->getPlaylistDAO();
+    const QString name=dao.getPlaylistName(playlistId);
+    if(dao.isPlaylistLocked(playlistId)) return QString("Playlist %1 is locked.").arg(name);
+    if(dao.isTrackInPlaylist(track->getId(),playlistId)) {
+        dao.removeTracksFromPlaylistById(playlistId,track->getId());
+        return QString("Removed from playlist %1.").arg(name);
+    }
+    return dao.appendTrackToPlaylist(track->getId(),playlistId)?
+            QString("Added to playlist %1.").arg(name):QStringLiteral("Playlist update failed.");
+}
+
+inline QString WRx3Browser::createTrackPlaylist() {
+    auto* collection=storageCollection();const auto track=toolTarget();
+    if(!collection || !track || !track->getId().isValid()) return QStringLiteral("Select a STORAGE track first.");
+    QString name=QString("NEW %1").arg(QDateTime::currentDateTime().toString("yyyy-MM-dd HH-mm"));
+    const int id=collection->getPlaylistDAO().createUniquePlaylist(&name);
+    if(id<0) return QStringLiteral("Playlist could not be created.");
+    return toggleTrackPlaylist(id);
+}
+
+inline void WRx3Browser::showTrackPlaylistMenu() {
+    const QString blocked=trackEditBlocked();
+    auto* collection=storageCollection();
+    if(!collection || !blocked.isEmpty()) {m_tools->message(blocked.isEmpty()?QStringLiteral("STORAGE is unavailable."):blocked);return;}
+    std::vector<ToolAction> actions;
+    actions.push_back(toolAction("NEW PLAYLIST  (ADD TRACK)",[this]{
+        const QString result=createTrackPlaylist();showTrackPlaylistMenu();m_tools->message(result);}));
+    auto& dao=collection->getPlaylistDAO();
+    for(const auto& entry:dao.getPlaylists(PlaylistDAO::PLHT_NOT_HIDDEN)) {
+        const int id=entry.first;const QString name=entry.second;
+        actions.push_back({[this,id,name]{
+                    auto* c=storageCollection();const auto track=toolTarget();
+                    const bool present=c && track && track->getId().isValid() &&
+                            c->getPlaylistDAO().isTrackInPlaylist(track->getId(),id);
+                    QString text=QString::fromUtf8(present?"●  ":"○  ");text.append(name);return text;},
+                [this,id]{m_tools->message(toggleTrackPlaylist(id));},{}});
+    }
+    m_tools->showMenu("ADD TO PLAYLIST",std::move(actions),[this]{showTrackToolsMenu();});
+    m_tools->message("Press a playlist to add or remove the track (● = already in it).");
+}
+
+inline QString WRx3Browser::scaleTrackBpm(mixxx::Beats::BpmScale scale) {
+    const QString blocked=trackEditBlocked();
+    if(!blocked.isEmpty()) return blocked;
+    const auto track=toolTarget();
+    if(track->isBpmLocked()) return QStringLiteral("BPM is locked. Choose UNLOCK BPM first.");
+    const mixxx::BeatsPointer beats=track->getBeats();
+    if(!beats) return QStringLiteral("This track has no beatgrid.");
+    const auto scaled=beats->tryScale(scale);
+    if(!scaled || !track->trySetBeats(*scaled)) return QStringLiteral("The beatgrid could not be scaled.");
+    return QString("BPM is now %1").arg(track->getBpm(),0,'f',2);
+}
+
+inline void WRx3Browser::showTrackBpmMenu() {
+    if(const QString blocked=trackEditBlocked();!blocked.isEmpty()) {m_tools->message(blocked);return;}
+    std::vector<ToolAction> actions;
+    actions.push_back({[this]{
+                const auto track=toolTarget();
+                return track?QString("BPM: %1%2").arg(track->getBpm(),0,'f',2).arg(track->isBpmLocked()?"  (LOCKED)":""):
+                        QStringLiteral("BPM: —");},
+            []{},{}});
+    using Scale=mixxx::Beats::BpmScale;
+    const struct {const char* label;Scale scale;} scales[]{
+            {"DOUBLE  (× 2)",Scale::Double},{"HALVE  (÷ 2)",Scale::Halve},
+            {"× 2/3",Scale::TwoThirds},{"× 3/4",Scale::ThreeFourths},
+            {"× 4/3",Scale::FourThirds},{"× 3/2",Scale::ThreeHalves}};
+    for(const auto& entry:scales) {
+        const Scale scale=entry.scale;
+        actions.push_back(toolAction(entry.label,[this,scale]{m_tools->message(scaleTrackBpm(scale));}));
+    }
+    actions.push_back({[this]{
+                const auto track=toolTarget();
+                return QString(track && track->isBpmLocked()?"UNLOCK BPM":"LOCK BPM");},
+            [this]{
+                if(const QString blocked=trackEditBlocked();!blocked.isEmpty()) {m_tools->message(blocked);return;}
+                const auto track=toolTarget();track->setBpmLocked(!track->isBpmLocked());
+                m_tools->message(track->isBpmLocked()?"BPM locked.":"BPM unlocked.");},{}});
+    actions.push_back(toolAction("UNDO LAST BPM / GRID CHANGE",[this]{
+        if(const QString blocked=trackEditBlocked();!blocked.isEmpty()) {m_tools->message(blocked);return;}
+        const auto track=toolTarget();
+        if(!track->canUndoBeatsChange()) {m_tools->message("Nothing to undo.");return;}
+        track->undoBeatsChange();m_tools->message(QString("BPM is now %1").arg(track->getBpm(),0,'f',2));}));
+    actions.push_back({[this]{
+                return QString(m_confirmId=="reset_beats" && m_confirmClock.isValid() && m_confirmClock.elapsed()<4000?
+                        "RESET BEATGRID — PRESS AGAIN TO CONFIRM":"RESET BEATGRID");},
+            [this]{
+                if(const QString blocked=trackEditBlocked();!blocked.isEmpty()) {m_tools->message(blocked);return;}
+                const auto track=toolTarget();
+                if(track->isBpmLocked()) {m_tools->message("BPM is locked. Choose UNLOCK BPM first.");return;}
+                if(!confirmed("reset_beats")) {m_tools->message("Press again within 4 seconds to erase the beatgrid.");return;}
+                track->trySetBeats(mixxx::BeatsPointer());m_tools->message("Beatgrid erased. UNDO restores it.");},{}});
+    m_tools->showMenu("BPM",std::move(actions),[this]{showTrackToolsMenu();});
+    m_tools->message("Changes apply immediately, also to a playing deck.");
+}
+
+namespace rx3 {
+// Plain colour names so a palette can be read at a glance on a small screen.
+inline QString colorName(const QColor& color) {
+    const int h=color.hsvHue(),s=color.hsvSaturation(),v=color.value();
+    if(v<70) return QStringLiteral("BLACK");
+    if(s<45) return v>190?QStringLiteral("WHITE"):QStringLiteral("GREY");
+    if(h<15 || h>=345) return QStringLiteral("RED");
+    if(h<40) return QStringLiteral("ORANGE");
+    if(h<70) return QStringLiteral("YELLOW");
+    if(h<165) return QStringLiteral("GREEN");
+    if(h<200) return QStringLiteral("AQUA");
+    if(h<255) return QStringLiteral("BLUE");
+    if(h<290) return QStringLiteral("PURPLE");
+    return QStringLiteral("PINK");
+}
+} // namespace rx3
+
+inline void WRx3Browser::showTrackColorMenu() {
+    if(const QString blocked=trackEditBlocked();!blocked.isEmpty()) {m_tools->message(blocked);return;}
+    const ColorPalette palette=ColorPaletteSettings(m_config).getTrackColorPalette();
+    std::vector<ToolAction> actions;
+    actions.push_back({[this]{
+                const auto track=toolTarget();
+                return QString::fromUtf8(track && !track->getColor()?"●  NO COLOR":"○  NO COLOR");},
+            [this]{
+                if(const QString blocked=trackEditBlocked();!blocked.isEmpty()) {m_tools->message(blocked);return;}
+                toolTarget()->setColor(std::nullopt);m_tools->message("Track colour removed.");},{}});
+    for(int i=0;i<palette.size();++i) {
+        const mixxx::RgbColor rgb=palette.at(i);
+        const QColor color=mixxx::RgbColor::toQColor(rgb);
+        const QString name=rx3::colorName(color);
+        ToolAction action;
+        action.label=[this,rgb,name]{
+            const auto track=toolTarget();
+            const auto current=track?track->getColor():std::nullopt;
+            QString text=QString::fromUtf8(current && *current==rgb?"●  ":"■  ");text.append(name);return text;};
+        action.execute=[this,rgb,name]{
+            if(const QString blocked=trackEditBlocked();!blocked.isEmpty()) {m_tools->message(blocked);return;}
+            toolTarget()->setColor(rgb);m_tools->message("Track colour: "+name);};
+        action.tint=[color]{return color;};
+        actions.push_back(std::move(action));
+    }
+    m_tools->showMenu("TRACK COLOR",std::move(actions),[this]{showTrackToolsMenu();});
+    m_tools->message("Press a colour to set it (● = current). The colour shows in every library view.");
+}
+
+inline void WRx3Browser::showPowerTools() {
+    showUtility();
+    openUtilityTools("POWER",[this]{showPowerMenu();});
+}
+
+inline void WRx3Browser::showPowerMenu() {
+    std::vector<ToolAction> actions;
+    const auto pending=[this](const QString& id) {
+        return m_confirmId==id && m_confirmClock.isValid() && m_confirmClock.elapsed()<4000;
+    };
+    const auto quit=[this]{if(auto* top=window()) top->close();};
+    actions.push_back({[pending]{return QString(pending("exit")?"EXIT NAUTICMIXXX — PRESS AGAIN TO CONFIRM":"EXIT NAUTICMIXXX");},
+            [this,quit]{
+                if(!confirmed("exit")) {m_tools->message("Press again within 4 seconds to close NauticMixxx.");return;}
+                QTimer::singleShot(0,this,quit);},{}});
+#ifdef Q_OS_LINUX
+    actions.push_back({[pending]{return QString(pending("sleep")?"SLEEP — PRESS AGAIN TO CONFIRM":"SLEEP  (SUSPEND THE DEVICE)");},
+            [this]{
+                if(!confirmed("sleep")) {m_tools->message("Press again within 4 seconds to suspend the device.");return;}
+                QProcess::startDetached("sh",{"-c","systemctl suspend || loginctl suspend"});},{}});
+    actions.push_back({[pending]{return QString(pending("shutdown")?"SHUTDOWN — PRESS AGAIN TO CONFIRM":"SHUTDOWN  (EXIT AND POWER OFF)");},
+            [this,quit]{
+                if(!confirmed("shutdown")) {m_tools->message("Press again within 4 seconds: NauticMixxx exits, then the device powers off.");return;}
+                // Started first, delayed so Mixxx can finish saving before the session ends.
+                QProcess::startDetached("sh",{"-c","sleep 3; systemctl poweroff || loginctl poweroff || shutdown -h now"});
+                QTimer::singleShot(0,this,quit);},{}});
+#endif
+    m_tools->showMenu("POWER",std::move(actions),[this]{showUtility();});
+#ifdef Q_OS_LINUX
+    m_tools->message("Each action asks for a second press. SLEEP and SHUTDOWN use systemd/logind.");
+#else
+    m_tools->message("Press EXIT twice to close NauticMixxx.");
+#endif
+}
