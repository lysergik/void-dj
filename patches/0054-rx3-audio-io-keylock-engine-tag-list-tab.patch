diff --git a/src/widget/wrx3browseraudioio.h b/src/widget/wrx3browseraudioio.h
new file mode 100644
index 0000000..797c0c7
--- /dev/null
+++ b/src/widget/wrx3browseraudioio.h
@@ -0,0 +1,147 @@
+#pragma once
+
+#include <QSet>
+
+#include "widget/rx3soundaccess.h"
+#include "soundio/soundmanagerconfig.h"
+#include "soundio/sounddevice.h"
+
+// UTILITY > AUDIO I/O: choose the sound card and channel pair of every Mixxx
+// audio input and output with the encoder, then APPLY.
+inline void WRx3Browser::showSoundCardTools() {
+    const auto manager=rx3SoundManager().lock();
+    if(!manager) {
+        m_tools->showMenu("AUDIO I/O",{},[this]{showUtility();});
+        m_tools->message("The sound manager is unavailable.");return;
+    }
+    struct Path {QString label;AudioPathType type;unsigned char index;bool output;};
+    struct Choice {bool none=true;SoundDeviceId id;unsigned char base=0;int channels=0;QString label;};
+    struct State {SoundManagerConfig draft;bool dirty=false;QList<Path> paths;};
+    
+    auto state=std::make_shared<State>(State{manager->getConfig(),false,{}});
+    
+    state->paths<<Path{"MASTER OUTPUT",AudioPathType::Main,0,true}
+        <<Path{"HEADPHONES OUTPUT",AudioPathType::Headphones,0,true}
+        <<Path{"BOOTH OUTPUT",AudioPathType::Booth,0,true};
+    const int decks=std::clamp(int(state->draft.getDeckCount()),1,4);
+    for(int i=0;i<decks;++i) state->paths<<Path{QString("DECK %1 OUTPUT").arg(i+1),AudioPathType::Deck,(unsigned char)i,true};
+    for(int i=0;i<decks;++i) state->paths<<Path{QString("DECK %1 TIMECODE / VINYL INPUT").arg(i+1),AudioPathType::VinylControl,(unsigned char)i,false};
+    for(int i=0;i<4;++i) state->paths<<Path{QString("MICROPHONE %1 INPUT").arg(i+1),AudioPathType::Microphone,(unsigned char)i,false};
+    for(int i=0;i<4;++i) state->paths<<Path{QString("AUXILIARY %1 INPUT").arg(i+1),AudioPathType::Auxiliary,(unsigned char)i,false};
+
+    const auto channelText=[](unsigned char base,int channels) {
+        return channels>1?QString("%1-%2").arg(base+1).arg(base+channels):QString::number(base+1);
+    };
+    // The current assignment of a path, or none.
+    const auto current=[state,channelText](const Path& path) -> Choice {
+        Choice choice;
+        const auto find=[&](auto map) {
+            for(auto it=map.cbegin();it!=map.cend();++it) {
+                if(it.value().getType()!=path.type || it.value().getIndex()!=path.index) continue;
+                choice.none=false;choice.id=it.key();choice.base=it.value().getChannelGroup().getChannelBase();
+                choice.channels=it.value().getChannelGroup().getChannelCount();
+                choice.label=it.key().name+" "+channelText(choice.base,choice.channels);
+            }
+        };
+        if(path.output) find(state->draft.getOutputs());else find(state->draft.getInputs());
+        return choice;
+    };
+    // Every free device/channel group for a path (channels used by another path on the same card are skipped).
+    const auto options=[state,manager,current,channelText](const Path& path) {
+        QList<Choice> list;list<<Choice{};
+        const int width=path.type==AudioPathType::Microphone?1:2;
+        QList<QPair<SoundDeviceId,QPair<int,int>>> used;
+        const auto collect=[&](auto map) {
+            for(auto it=map.cbegin();it!=map.cend();++it) {
+                if(it.value().getType()==path.type && it.value().getIndex()==path.index) continue;
+                used<<qMakePair(it.key(),qMakePair(int(it.value().getChannelGroup().getChannelBase()),int(it.value().getChannelGroup().getChannelCount())));
+            }
+        };
+        if(path.output) collect(state->draft.getOutputs());else collect(state->draft.getInputs());
+        const auto devices=manager->getDeviceList(state->draft.getAPI(),path.output,!path.output);
+        for(const auto& device:devices) {
+            const int total=path.output?int(device->getNumOutputChannels()):int(device->getNumInputChannels());
+            for(int base=0;base+width<=total;base+=width) {
+                bool clash=false;
+                for(const auto& other:used) if(other.first==device->getDeviceId() &&
+                        base<other.second.first+other.second.second && other.second.first<base+width) clash=true;
+                if(clash) continue;
+                Choice choice;choice.none=false;choice.id=device->getDeviceId();choice.base=(unsigned char)base;choice.channels=width;
+                choice.label=device->getDisplayName()+" "+channelText((unsigned char)base,width);
+                list<<choice;
+            }
+        }
+        return list;
+    };
+    const auto assign=[state](const Path& path,const Choice& choice) {
+        const auto outputs=state->draft.getOutputs();const auto inputs=state->draft.getInputs();
+        if(path.output) {
+            state->draft.clearOutputs();
+            for(auto it=outputs.cbegin();it!=outputs.cend();++it)
+                if(!(it.value().getType()==path.type && it.value().getIndex()==path.index)) state->draft.addOutput(it.key(),it.value());
+            if(!choice.none) state->draft.addOutput(choice.id,AudioOutput(path.type,choice.base,mixxx::audio::ChannelCount(choice.channels),path.index));
+        } else {
+            state->draft.clearInputs();
+            for(auto it=inputs.cbegin();it!=inputs.cend();++it)
+                if(!(it.value().getType()==path.type && it.value().getIndex()==path.index)) state->draft.addInput(it.key(),it.value());
+            if(!choice.none) state->draft.addInput(choice.id,AudioInput(path.type,choice.base,mixxx::audio::ChannelCount(choice.channels),path.index));
+        }
+        state->dirty=true;
+    };
+
+    std::vector<WRx3ToolMenu::Action> actions;
+    for(const auto& path:state->paths) {
+        actions.push_back({
+            [path,current]{const auto c=current(path);return QString(path.label+":  "+(c.none?QString("— NONE —"):c.label));},
+            {},
+            [path,options,current,assign,this](int delta) {
+                const auto list=options(path);const auto now=current(path);
+                int index=0;
+                for(int i=0;i<list.size();++i) if(!list[i].none && !now.none && list[i].id==now.id && list[i].base==now.base) index=i;
+                index=((index+delta)%list.size()+list.size())%list.size();
+                assign(path,list[index]);
+                m_tools->message("Press to finish, then choose APPLY to switch the sound card.");
+            }});
+    }
+    // Sample rate of the selected API.
+    {
+        actions.push_back({
+            [state]{return QString("SAMPLE RATE:  %1 Hz").arg(int(state->draft.getSampleRate()));},
+            {},
+            [state,manager](int delta) {
+                const auto rates=manager->getSampleRates(state->draft.getAPI());
+                if(rates.isEmpty()) return;
+                int index=0;
+                for(int i=0;i<rates.size();++i) if(rates[i]==state->draft.getSampleRate()) index=i;
+                index=((index+delta)%rates.size()+rates.size())%rates.size();
+                state->draft.setSampleRate(rates[index]);state->dirty=true;
+            }});
+    }
+    actions.push_back({
+        [state]{return state->dirty?QString("APPLY CHANGES ›"):QString("APPLY (NO CHANGES)");},
+        [this,state,manager]{
+            if(!state->dirty) {m_tools->message("Nothing to apply.");return;}
+            const auto previous=manager->getConfig();
+            const auto status=manager->setConfig(state->draft);
+            if(status==SoundDeviceStatus::Ok) {
+                state->draft.writeToDisk();
+                state->draft=manager->getConfig();state->dirty=false;
+                m_tools->message("Audio configuration applied and saved.");
+            } else {
+                const QString error=manager->getLastErrorMessage(status);
+                manager->setConfig(previous);
+                state->draft=manager->getConfig();state->dirty=false;
+                m_tools->message("Not applied: "+error+" The previous configuration was restored.");
+            }
+            m_tools->refresh();
+        },{}});
+    actions.push_back({
+        []{return QString("RESCAN SOUND CARDS ›");},
+        [this,state,manager]{
+            manager->clearAndQueryDevices();
+            m_tools->message("Sound cards rescanned.");
+            m_tools->refresh();
+        },{}});
+    m_tools->showMenu("AUDIO I/O — SOUND CARDS",std::move(actions),[this]{showUtility();});
+    m_tools->message("Press a line, turn to choose the sound card and channels, press again to finish. Then APPLY.");
+}
