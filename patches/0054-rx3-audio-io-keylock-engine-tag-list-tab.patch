index 0000000..421cf72
--- /dev/null
+++ b/src/widget/rx3soundaccess.h
@@ -0,0 +1,14 @@
+#pragma once
+
+#include <memory>
+
+#include "soundio/soundmanager.h"
+
+// The skin widgets are created long after CoreServices, but the legacy skin
+// parser has no access to it. MixxxMainWindow publishes the sound manager here
+// so the STORAGE/UTILITY pages can configure audio I/O without the preferences
+// dialog.
+inline std::weak_ptr<SoundManager>& rx3SoundManager() {
+    static std::weak_ptr<SoundManager> manager;
+    return manager;
+}
