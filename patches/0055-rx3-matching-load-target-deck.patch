+#include <functional>
+
+// Deck chosen in the RX3 browser (MATCHING: DECK 1 / DECK 2) that a plain
+// double-click / touch load should target; 0 means "no preference" and Mixxx's
+// usual first-free-deck rule applies. Evaluated lazily so it is always current.
+inline std::function<int()>& rx3LoadTargetDeck() {
+    static std::function<int()> provider;
+    return provider;
+}
