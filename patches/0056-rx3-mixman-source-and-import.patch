new file mode 100644
index 0000000..ae58650
--- /dev/null
+++ b/src/widget/wrx3browsermixman.h
@@ -0,0 +1,194 @@
+#pragma once
+
+#include <QDir>
+#include <QElapsedTimer>
+#include <QPointer>
+#include <QSet>
+#include <QStandardPaths>
+#include <QTimer>
+
+#include "analyzer/analyzerscheduledtrack.h"
+#include "library/mixman/mixmanstick.h"
+#include "library/rekordbox/rekordboxdevice.h"
+#include "track/beats.h"
+#include "track/track.h"
+#include "util/color/rgbcolor.h"
+
+// A stick written by mixman has MIXMAN/library.sqlite and no PIONEER folder.
+inline bool WRx3Browser::isMixmanRoot(const QString& root) const {
+    return !root.isEmpty() && !QFileInfo(QDir(root).filePath("PIONEER")).exists() &&
+            !QFileInfo(QDir(root).filePath(".PIONEER")).exists() &&
+            !mixxx::mixman::databasePath(root).isEmpty();
+}
+
+// Roots of the connected sources that are mixman sticks.
+inline QStringList WRx3Browser::mixmanRoots() const {
+    QStringList roots;
+    for(const auto& device:m_devices) {
+        const QString root=deviceRoot(device);
+        if(isMixmanRoot(root) && !roots.contains(root)) roots.append(root);
+    }
+    return roots;
+}
+
+// UTILITY / SOURCE > IMPORT TO STORAGE: copies a mixman stick into the local
+// library (audio, tags, beat grid, cues, colours, crates and playlists), one
+// track per event-loop turn so the interface and the audio engine stay live.
+// Tracks that already exist (same file) are never changed; crates and playlists
+// are merged by name.
+inline void WRx3Browser::showMixmanImport(const QString& root,std::function<void()> back) {
+    struct Job {
+        mixxx::mixman::Stick stick;
+        QString root,destination;
+        int index=0;
+        int added=0,existing=0,missing=0,failed=0;
+        qint64 bytes=0;
+        QHash<qint64,TrackId> ids;
+        QList<TrackId> created;
+        bool running=false,finished=false;
+        QString summary;
+    };
+    auto job=std::make_shared<Job>();
+    job->root=root;
+    QString error;
+    mixxx::mixman::Stick stick;
+    if(!mixxx::mixman::read(root,&stick,&error)) {
+        m_tools->showMenu("IMPORT MIXMAN",{},back?back:std::function<void()>([this]{showUtility();}));
+        m_tools->message("Cannot read this MIXMAN stick: "+error);return;
+    }
+    job->stick=std::move(stick);
+    const QString saved=m_config?m_config->getValueString(ConfigKey("[RX3Import]","destination")):QString();
+    job->destination=saved.isEmpty()?QDir(QStandardPaths::writableLocation(QStandardPaths::MusicLocation)).filePath("MIXMAN"):saved;
+    QPointer<WRx3Browser> guard(this);
+    const auto describe=[job]() -> QString {
+        return QString("%1 tracks, %2 crates, %3 playlists").arg(job->stick.tracks.size()).arg(job->stick.crates.size()).arg(job->stick.playlists.size());
+    };
+    // One step: copy one track's audio, add it to the library, apply its stick data.
+    const auto step=[guard,job]() {
+        if(!guard) return;
+        auto* self=guard.data();
+        auto* manager=self->m_backend?self->m_backend->trackCollectionManager():nullptr;
+        if(!manager) {job->failed=job->stick.tracks.size();job->finished=true;return;}
+        const auto& source=job->stick.tracks[job->index];
+        const QString from=mixxx::rekordbox::resolvePath(job->root,source.relativePath);
+        QString relative=source.relativePath;
+        for(const QString& prefix:{QStringLiteral("MIXMAN/Contents/"),QStringLiteral("Contents/")})
+            if(relative.startsWith(prefix)) {relative=relative.mid(prefix.size());break;}
+        const QString to=QDir(job->destination).filePath(relative);
+        if(from.isEmpty() || !QFileInfo(from).isFile()) {++job->missing;return;}
+        const qint64 size=QFileInfo(from).size();
+        if(!(QFileInfo(to).isFile() && QFileInfo(to).size()==size)) {
+            QDir().mkpath(QFileInfo(to).absolutePath());
+            const QString part=to+".part";
+            QFile::remove(part);
+            if(!QFile::copy(from,part) || !QFile::rename(part,to)) {QFile::remove(part);++job->failed;return;}
+            job->bytes+=size;
+        }
+        bool already=false;
+        TrackPointer track=manager->getOrAddTrack(TrackRef::fromFilePath(to),&already);
+        if(!track || !track->getId().isValid()) {++job->failed;return;}
+        job->ids.insert(source.id,track->getId());
+        if(already) {++job->existing;return;}
+        ++job->added;
+        job->created.append(track->getId());
+        track->setTitle(source.title);
+        track->setArtist(source.artist);
+        track->setAlbum(source.album);
+        track->setAlbumArtist(source.albumArtist);
+        track->updateGenre(source.genre);
+        track->setYear(source.year);
+        track->setComment(source.comment);
+        track->setComposer(source.composer);
+        track->setGrouping(source.grouping);
+        if(source.rating>=0 && source.rating<=5) track->setRating(source.rating);
+        if(source.color) track->setColor(mixxx::RgbColor::optional(mixxx::RgbColor::validateCode(*source.color)));
+        if(!source.key.isEmpty()) track->setKeyText(source.key,mixxx::track::io::key::FILE_METADATA);
+        const auto rate=track->getSampleRate().isValid()?track->getSampleRate():mixxx::audio::SampleRate(source.samplerate);
+        if(!source.beats.isEmpty() && !source.beatsVersion.isEmpty() && rate.isValid()) {
+            if(const auto beats=mixxx::Beats::fromByteArray(rate,source.beatsVersion,source.beatsSubVersion,source.beats)) {
+                track->trySetBeats(beats);
+                if(source.bpmLocked) track->setBpmLocked(true);
+            }
+        }
+        for(const auto& cue:source.cues) {
+            if(cue.type==1 && cue.hotcue>=0)
+                track->createAndAddCue(mixxx::CueType::HotCue,cue.hotcue,cue.position,-1.0,
+                        mixxx::RgbColor(mixxx::RgbColor::validateCode(cue.color.value_or(0xFF0000))))->setLabel(cue.label);
+            else if(cue.type==4 && cue.length>0)
+                track->createAndAddCue(cue.hotcue>=0?mixxx::CueType::Loop:mixxx::CueType::Loop,cue.hotcue,cue.position,cue.position+cue.length,
+                        mixxx::RgbColor(mixxx::RgbColor::validateCode(cue.color.value_or(0xFF0000))))->setLabel(cue.label);
+        }
+        if(source.mainCue>=0) track->setMainCuePosition(mixxx::audio::FramePos::fromEngineSamplePosMaybeInvalid(source.mainCue));
+    };
+    // Crates and playlists, merged by name once every track is in the library.
+    const auto finish=[guard,job]() {
+        if(!guard) return;
+        auto* self=guard.data();
+        auto* collection=self->storageCollection();
+        int crates=0,playlists=0;
+        if(collection) {
+            for(const auto& list:job->stick.crates) {
+                QList<TrackId> members;
+                for(const auto id:list.trackIds) if(job->ids.contains(id)) members.append(job->ids.value(id));
+                Crate crate;CrateId crateId;
+                if(collection->crates().readCrateByName(list.name,&crate)) crateId=crate.getId();
+                else {Crate created;created.setName(list.name);if(!collection->insertCrate(created,&crateId)) continue;}
+                if(crateId.isValid() && !members.isEmpty()) collection->addCrateTracks(crateId,members);
+                ++crates;
+            }
+            auto& dao=collection->getPlaylistDAO();
+            for(const auto& list:job->stick.playlists) {
+                int playlistId=dao.getPlaylistIdFromName(list.name);
+                if(playlistId<0) playlistId=dao.createPlaylist(list.name);
+                if(playlistId<0) continue;
+                QList<TrackId> members;
+                for(const auto id:list.trackIds) {
+                    const auto local=job->ids.value(id);
+                    if(local.isValid() && !dao.isTrackInPlaylist(local,playlistId) && !members.contains(local)) members.append(local);
+                }
+                if(!members.isEmpty()) dao.appendTracksToPlaylist(members,playlistId);
+                ++playlists;
+            }
+        }
+        // New tracks get their own waveform from the normal analysis queue;
+        // the imported beat grids are kept.
+        if(!job->created.isEmpty() && self->m_backend) {
+            QList<AnalyzerScheduledTrack> tracks;
+            for(const auto id:job->created) tracks.append(AnalyzerScheduledTrack(id));
+            emit self->m_backend->analyzeTracks(tracks);
+        }
+        job->summary=QString("Done: %1 added, %2 already in STORAGE, %3 crates, %4 playlists.").arg(job->added).arg(job->existing).arg(crates).arg(playlists);
+        if(job->missing) job->summary+=QString(" %1 file(s) missing on the stick.").arg(job->missing);
+        if(job->failed) job->summary+=QString(" %1 failed.").arg(job->failed);
+        job->finished=true;job->running=false;
+    };
+    // The timer chain: one track per turn, then the lists.
+    auto run=std::make_shared<std::function<void()>>();
+    *run=[guard,job,step,finish,run]() {
+        if(!guard) return;
+        auto* self=guard.data();
+        if(job->index<job->stick.tracks.size()) {
+            step();++job->index;
+            self->m_tools->message(QString("Importing %1 / %2 …").arg(job->index).arg(job->stick.tracks.size()));
+            self->m_tools->refresh();
+            QTimer::singleShot(0,self,[run]{(*run)();});
+        } else {
+            finish();
+            self->m_tools->message(job->summary);self->m_tools->refresh();
+        }
+    };
+    std::vector<ToolAction> actions;
+    actions.push_back({[job,describe]() -> QString {return QString("STICK:  ")+describe();},{},{}});
+    actions.push_back({[job]() -> QString {return QString("COPY AUDIO TO:  ")+job->destination;},{},{}});
+    actions.push_back({[job]() -> QString {
+            return job->running?QString("IMPORTING …"):job->finished?QString("IMPORT AGAIN ›"):QString("START IMPORT ›");},
+        [job,run,this]{
+            if(job->running) return;
+            if(job->stick.tracks.isEmpty()) {m_tools->message("This stick has no tracks.");return;}
+            job->index=0;job->added=job->existing=job->missing=job->failed=0;job->bytes=0;
+            job->ids.clear();job->created.clear();job->running=true;job->finished=false;
+            QTimer::singleShot(0,this,[run]{(*run)();});
+        },{}});
+    m_tools->showMenu("IMPORT MIXMAN STICK TO STORAGE",std::move(actions),back?back:std::function<void()>([this]{showUtility();}));
+    m_tools->message("Audio is copied to the folder above; tags, beat grids, cues, crates and playlists are brought into STORAGE. Existing tracks are left untouched.");
+}
