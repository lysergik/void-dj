diff --git a/src/library/mixman/mixmanstick.h b/src/library/mixman/mixmanstick.h
new file mode 100644
index 0000000..9199383
--- /dev/null
+++ b/src/library/mixman/mixmanstick.h
@@ -0,0 +1,290 @@
+#pragma once
+
+// Reader for sticks written by the `mixman` exporter (see FORMAT.md of mixman):
+//
+//   <stick>/MIXMAN/library.sqlite   Mixxx-schema subset + meta table
+//   <stick>/MIXMAN/analysis/<id>    Mixxx waveform analysis files
+//   <stick>/MIXMAN/Contents/...     audio (track_locations.location is relative to the stick)
+//
+// The database is only ever opened read-only. Everything here is plain value
+// data so the same reader serves the SOURCE catalog (browse/load from the
+// stick) and the importer (copy into the STORAGE library).
+
+#include <QByteArray>
+#include <QDir>
+#include <QFile>
+#include <QFileInfo>
+#include <QList>
+#include <QSqlDatabase>
+#include <QSqlError>
+#include <QSqlQuery>
+#include <QSqlRecord>
+#include <QString>
+#include <QUuid>
+#include <QVariant>
+
+#include <optional>
+
+namespace mixxx::mixman {
+
+constexpr int kSupportedFormatVersion = 1;
+
+struct Cue {
+    int type{0};          // Mixxx CueType numbering (1 hot cue, 2 main cue, 4 loop, ...)
+    double position{0};   // engine samples (frames * 2)
+    double length{0};     // engine samples
+    int hotcue{-1};
+    QString label;
+    std::optional<quint32> color;
+};
+
+struct Analysis {
+    qint64 id{0};
+    int type{0};          // 1 waveform, 2 summary
+    QString description;
+    QString version;
+    qint64 checksum{0};
+};
+
+struct Track {
+    qint64 id{0};
+    QString artist, title, album, albumArtist, genre, year, comment, composer, grouping, key;
+    double bpm{0};
+    double duration{0};
+    int samplerate{0};
+    int rating{0};
+    bool bpmLocked{false};
+    std::optional<quint32> color;
+    double mainCue{-1};   // engine samples
+    QString relativePath; // relative to the stick root, forward slashes
+    qint64 fileSize{0};
+    QByteArray beats;
+    QString beatsVersion;
+    QString beatsSubVersion;
+    QList<Cue> cues;
+    QList<Analysis> analyses;
+};
+
+struct List {
+    qint64 id{0};
+    QString name;
+    QList<qint64> trackIds; // in order
+};
+
+struct Stick {
+    QString root;
+    QString databasePath;
+    QString exportId;
+    qint64 createdUnix{0};
+    QList<Track> tracks;
+    QList<List> crates;
+    QList<List> playlists;
+};
+
+// `MIXMAN/library.sqlite` inside the stick root, or an empty string.
+inline QString databasePath(const QString& root) {
+    if (root.isEmpty()) return {};
+    const QString candidate = QDir(root).filePath(QStringLiteral("MIXMAN/library.sqlite"));
+    const QFileInfo info(candidate);
+    if (!info.isFile() || info.isSymLink()) return {};
+    const QString canonicalRoot = QFileInfo(root).canonicalFilePath();
+    const QString canonical = info.canonicalFilePath();
+    if (canonicalRoot.isEmpty() || !canonical.startsWith(canonicalRoot + QLatin1Char('/'))) return {};
+    return candidate;
+}
+
+inline QString analysisFilePath(const QString& root, qint64 id) {
+    return QDir(root).filePath(QStringLiteral("MIXMAN/analysis/") + QString::number(id));
+}
+
+namespace detail {
+inline QString text(const QSqlRecord& r, const char* column) {
+    const int i = r.indexOf(QLatin1String(column));
+    return i < 0 || r.isNull(i) ? QString() : r.value(i).toString();
+}
+inline double number(const QSqlRecord& r, const char* column, double fallback = 0) {
+    const int i = r.indexOf(QLatin1String(column));
+    return i < 0 || r.isNull(i) ? fallback : r.value(i).toDouble();
+}
+inline qint64 integer(const QSqlRecord& r, const char* column, qint64 fallback = 0) {
+    const int i = r.indexOf(QLatin1String(column));
+    return i < 0 || r.isNull(i) ? fallback : r.value(i).toLongLong();
+}
+inline std::optional<quint32> rgb(const QSqlRecord& r, const char* column) {
+    const int i = r.indexOf(QLatin1String(column));
+    if (i < 0 || r.isNull(i)) return std::nullopt;
+    const qint64 value = r.value(i).toLongLong();
+    if (value < 0) return std::nullopt;
+    return static_cast<quint32>(value & 0xFFFFFF);
+}
+inline bool tableExists(QSqlDatabase& db, const QString& name) {
+    QSqlQuery q(db);
+    q.prepare(QStringLiteral("SELECT 1 FROM sqlite_master WHERE type='table' AND name=? COLLATE NOCASE"));
+    q.addBindValue(name);
+    return q.exec() && q.next();
+}
+} // namespace detail
+
+// Read the whole export. `error` is set on failure. Safe to call from a worker thread.
+inline bool read(const QString& root, Stick* stick, QString* error) {
+    const QString path = databasePath(root);
+    if (path.isEmpty()) {
+        if (error) *error = QStringLiteral("No MIXMAN export found");
+        return false;
+    }
+    const QString connection = QStringLiteral("rx3-mixman-") + QUuid::createUuid().toString(QUuid::WithoutBraces);
+    bool ok = false;
+    {
+        QSqlDatabase db = QSqlDatabase::addDatabase(QStringLiteral("QSQLITE"), connection);
+        db.setDatabaseName(path);
+        db.setConnectOptions(QStringLiteral("QSQLITE_OPEN_READONLY"));
+        if (!db.open()) {
+            if (error) *error = db.lastError().text();
+        } else {
+            ok = [&]() -> bool {
+                QSqlQuery q(db);
+                if (!detail::tableExists(db, QStringLiteral("meta")) ||
+                        !q.exec(QStringLiteral("SELECT key, value FROM meta"))) {
+                    if (error) *error = QStringLiteral("Not a MIXMAN export (no meta table)");
+                    return false;
+                }
+                QString format;
+                int version = 0;
+                while (q.next()) {
+                    const QString key = q.value(0).toString();
+                    const QString value = q.value(1).toString();
+                    if (key == QLatin1String("format")) format = value;
+                    else if (key == QLatin1String("format_version")) version = value.toInt();
+                    else if (key == QLatin1String("export_id")) stick->exportId = value;
+                    else if (key == QLatin1String("created_unix")) stick->createdUnix = value.toLongLong();
+                }
+                if (format != QLatin1String("mixman-export")) {
+                    if (error) *error = QStringLiteral("Not a MIXMAN export");
+                    return false;
+                }
+                if (version > kSupportedFormatVersion) {
+                    if (error) *error = QStringLiteral("Export made by a newer mixman (format %1)").arg(version);
+                    return false;
+                }
+                stick->root = root;
+                stick->databasePath = path;
+
+                // tracks
+                if (!q.exec(QStringLiteral(
+                            "SELECT l.*, tl.location AS rel_location, tl.filesize AS rel_filesize "
+                            "FROM library l JOIN track_locations tl ON tl.id = l.location "
+                            "WHERE COALESCE(l.mixxx_deleted, 0) = 0 ORDER BY l.id"))) {
+                    if (error) *error = q.lastError().text();
+                    return false;
+                }
+                while (q.next()) {
+                    const QSqlRecord r = q.record();
+                    Track t;
+                    t.id = detail::integer(r, "id");
+                    t.artist = detail::text(r, "artist");
+                    t.title = detail::text(r, "title");
+                    t.album = detail::text(r, "album");
+                    t.albumArtist = detail::text(r, "album_artist");
+                    t.genre = detail::text(r, "genre");
+                    t.year = detail::text(r, "year");
+                    t.comment = detail::text(r, "comment");
+                    t.composer = detail::text(r, "composer");
+                    t.grouping = detail::text(r, "grouping");
+                    t.key = detail::text(r, "key");
+                    t.bpm = detail::number(r, "bpm");
+                    t.duration = detail::number(r, "duration");
+                    t.samplerate = int(detail::integer(r, "samplerate"));
+                    t.rating = int(detail::integer(r, "rating"));
+                    t.bpmLocked = detail::integer(r, "bpm_lock") != 0;
+                    t.color = detail::rgb(r, "color");
+                    t.mainCue = detail::number(r, "cuepoint", -1);
+                    t.relativePath = detail::text(r, "rel_location");
+                    t.relativePath.replace(QLatin1Char('\\'), QLatin1Char('/'));
+                    t.fileSize = detail::integer(r, "rel_filesize");
+                    const int beats = r.indexOf(QLatin1String("beats"));
+                    if (beats >= 0 && !r.isNull(beats)) t.beats = r.value(beats).toByteArray();
+                    t.beatsVersion = detail::text(r, "beats_version");
+                    t.beatsSubVersion = detail::text(r, "beats_sub_version");
+                    if (t.id <= 0 || t.id > 0x7fffffffLL || t.relativePath.isEmpty()) continue;
+                    stick->tracks.append(std::move(t));
+                }
+                QHash<qint64, int> index;
+                for (int i = 0; i < stick->tracks.size(); ++i) index.insert(stick->tracks[i].id, i);
+
+                // cues
+                if (detail::tableExists(db, QStringLiteral("cues")) &&
+                        q.exec(QStringLiteral("SELECT * FROM cues ORDER BY track_id, hotcue, position"))) {
+                    while (q.next()) {
+                        const QSqlRecord r = q.record();
+                        const auto it = index.constFind(detail::integer(r, "track_id"));
+                        if (it == index.cend()) continue;
+                        Cue c;
+                        c.type = int(detail::integer(r, "type"));
+                        c.position = detail::number(r, "position");
+                        c.length = detail::number(r, "length");
+                        c.hotcue = int(detail::integer(r, "hotcue", -1));
+                        c.label = detail::text(r, "label");
+                        c.color = detail::rgb(r, "color");
+                        stick->tracks[*it].cues.append(std::move(c));
+                    }
+                }
+                // waveform analysis files
+                if (detail::tableExists(db, QStringLiteral("track_analysis")) &&
+                        q.exec(QStringLiteral("SELECT * FROM track_analysis ORDER BY track_id, type"))) {
+                    while (q.next()) {
+                        const QSqlRecord r = q.record();
+                        const auto it = index.constFind(detail::integer(r, "track_id"));
+                        if (it == index.cend()) continue;
+                        Analysis a;
+                        a.id = detail::integer(r, "id");
+                        a.type = int(detail::integer(r, "type"));
+                        a.description = detail::text(r, "description");
+                        a.version = detail::text(r, "version");
+                        a.checksum = detail::integer(r, "data_checksum");
+                        stick->tracks[*it].analyses.append(std::move(a));
+                    }
+                }
+                // crates and playlists
+                const auto readLists = [&](const QString& listSql, const QString& memberTable,
+                                               const QString& listColumn, const QString& order,
+                                               QList<List>* out) {
+                    QSqlQuery lists(db);
+                    if (!lists.exec(listSql)) return;
+                    while (lists.next()) {
+                        List l;
+                        l.id = lists.value(0).toLongLong();
+                        l.name = lists.value(1).toString();
+                        QSqlQuery members(db);
+                        members.prepare(QStringLiteral("SELECT track_id FROM %1 WHERE %2 = ? %3")
+                                                .arg(memberTable, listColumn, order));
+                        members.addBindValue(l.id);
+                        if (members.exec()) {
+                            while (members.next()) {
+                                const qint64 id = members.value(0).toLongLong();
+                                if (index.contains(id)) l.trackIds.append(id);
+                            }
+                        }
+                        out->append(std::move(l));
+                    }
+                };
+                if (detail::tableExists(db, QStringLiteral("crates")) &&
+                        detail::tableExists(db, QStringLiteral("crate_tracks"))) {
+                    readLists(QStringLiteral("SELECT id, name FROM crates ORDER BY name COLLATE NOCASE"),
+                            QStringLiteral("crate_tracks"), QStringLiteral("crate_id"), QString(), &stick->crates);
+                }
+                if (detail::tableExists(db, QStringLiteral("Playlists")) &&
+                        detail::tableExists(db, QStringLiteral("PlaylistTracks"))) {
+                    readLists(QStringLiteral("SELECT id, name FROM Playlists WHERE COALESCE(hidden,0)=0 ORDER BY position, name"),
+                            QStringLiteral("PlaylistTracks"), QStringLiteral("playlist_id"),
+                            QStringLiteral("ORDER BY position"), &stick->playlists);
+                }
+                return true;
+            }();
+            db.close();
+        }
+    }
+    QSqlDatabase::removeDatabase(connection);
+    return ok;
+}
+
+} // namespace mixxx::mixman
diff --git a/src/library/rekordbox/mixmancatalog.h b/src/library/rekordbox/mixmancatalog.h
new file mode 100644
index 0000000..2ab7b07
--- /dev/null
+++ b/src/library/rekordbox/mixmancatalog.h
@@ -0,0 +1,206 @@
+#pragma once
+
+// MIXMAN sticks as a SOURCE: the stick is projected into the same runtime
+// catalog as a Rekordbox USB, so browsing (ARTIST/ALBUM/TRACK/KEY/PLAYLIST/
+// MATCHING/FOLDER/SEARCH), deck loading and the read-only rules are shared.
+
+#include <QBuffer>
+#include <QByteArray>
+#include <QFile>
+#include <QJsonObject>
+#include <QSet>
+#include <QtGlobal>
+
+#include "library/mixman/mixmanstick.h"
+#include "library/rekordbox/rekordboxdevice.h"
+#include "library/rekordbox/rekordboxruntimecatalog.h"
+#include "track/beats.h"
+#include "track/beatsimporter.h"
+#include "track/track.h"
+#include "waveform/waveform.h"
+#include "waveform/waveformfactory.h"
+
+namespace mixxx::rekordbox {
+
+constexpr quint32 kMixmanCratesFolderId = 900000;
+constexpr quint32 kMixmanCrateBase = 900001;
+
+inline bool isMixmanTrack(const RuntimeTrack& track) {
+    return track.rawMetadata.value(QStringLiteral("mixman")).toBool();
+}
+
+// Beats stay Mixxx's own serialized grid; the importer decodes them once the
+// decoder's real sample rate is known (same lifecycle as the Rekordbox grid).
+class MixmanBeatsImporter final : public mixxx::BeatsImporter {
+  public:
+    MixmanBeatsImporter(QByteArray blob, QString version, QString subVersion)
+            : m_blob(std::move(blob)), m_version(std::move(version)), m_subVersion(std::move(subVersion)) {}
+    bool isEmpty() const override { return m_blob.isEmpty() || m_version.isEmpty(); }
+    mixxx::BeatsPointer importBeatsAndApplyTimingOffset(const QString&, const QString&,
+            const mixxx::audio::StreamInfo& streamInfo) override {
+        const auto rate = streamInfo.getSignalInfo().getSampleRate();
+        if (isEmpty() || !rate.isValid()) return nullptr;
+        return mixxx::Beats::fromByteArray(rate, m_version, m_subVersion, m_blob);
+    }
+  private:
+    QByteArray m_blob;
+    QString m_version;
+    QString m_subVersion;
+};
+
+inline bool populateMixman(const QString& root, const mixman::Stick& stick,
+        RuntimeCatalog* catalog, QString* error) {
+    BrowseMenu menu;
+    quint16 id = 1;
+    for (const char* label : {"ARTIST", "ALBUM", "TRACK", "KEY", "GENRE", "PLAYLIST", "MATCHING", "FOLDER", "SEARCH"}) {
+        BrowseCategory category;
+        category.id = id;
+        category.label = QString::fromLatin1(label);
+        category.position = id;
+        menu.categories.append(category);
+        ++id;
+    }
+    menu.fromExport = true;
+    catalog->setBrowseMenu(menu);
+
+    for (const auto& source : stick.tracks) {
+        RuntimeTrack track;
+        track.rekordboxId = static_cast<quint32>(source.id);
+        track.title = source.title;
+        track.artist = source.artist;
+        track.album = source.album;
+        track.genre = source.genre;
+        track.comment = source.comment;
+        track.key = source.key;
+        track.composer = source.composer;
+        if (source.bpm > 0) track.bpm = source.bpm;
+        if (source.duration > 0) track.durationSeconds = static_cast<quint32>(source.duration + 0.5);
+        if (source.rating >= 0 && source.rating <= 5) track.rating = static_cast<quint32>(source.rating);
+        track.audioRelativePath = source.relativePath;
+        track.resolvedAudioPath = resolvePath(root, source.relativePath, false);
+        if (track.resolvedAudioPath.isEmpty()) {
+            track.diagnostics.append(QStringLiteral("Unsafe or unresolvable export path: %1").arg(source.relativePath));
+        } else if (!QFileInfo::exists(track.resolvedAudioPath)) {
+            track.diagnostics.append(QStringLiteral("Export file is missing: %1").arg(source.relativePath));
+        }
+        const double rate = source.samplerate > 0 ? source.samplerate : 44100;
+        const auto millis = [rate](double samples) { return samples / 2.0 / rate * 1000.0; };
+        bool hasMain = false;
+        for (const auto& cue : source.cues) {
+            if (cue.position < 0 && cue.type != 2) continue;
+            RuntimeCue runtime;
+            runtime.label = cue.label;
+            if (cue.color) runtime.color = mixxx::RgbColor::optional(mixxx::RgbColor::validateCode(*cue.color));
+            runtime.startMs = millis(cue.position);
+            if (cue.type == 1 && cue.hotcue >= 0) {
+                runtime.kind = RuntimeCue::Kind::HotCue;
+                runtime.hotcueIndex = cue.hotcue + 1;
+            } else if (cue.type == 2) {
+                if (cue.position < 0 || hasMain) continue;
+                hasMain = true;
+                runtime.kind = RuntimeCue::Kind::MemoryCue;
+            } else if (cue.type == 4 && cue.length > 0) {
+                runtime.endMs = millis(cue.position + cue.length);
+                if (cue.hotcue >= 0) {
+                    runtime.kind = RuntimeCue::Kind::HotLoop;
+                    runtime.hotcueIndex = cue.hotcue + 1;
+                } else {
+                    runtime.kind = RuntimeCue::Kind::MemoryLoop;
+                }
+            } else {
+                continue;
+            }
+            track.cues.append(std::move(runtime));
+        }
+        if (!hasMain && source.mainCue > 0) {
+            RuntimeCue main;
+            main.kind = RuntimeCue::Kind::MemoryCue;
+            main.startMs = millis(source.mainCue);
+            track.cues.prepend(std::move(main));
+        }
+        track.analysisState = RuntimeAnalysisState::Missing;
+        QJsonObject raw;
+        raw.insert(QStringLiteral("mixman"), true);
+        raw.insert(QStringLiteral("year"), source.year);
+        raw.insert(QStringLiteral("beats"), QString::fromLatin1(source.beats.toBase64()));
+        raw.insert(QStringLiteral("beats_version"), source.beatsVersion);
+        raw.insert(QStringLiteral("beats_sub_version"), source.beatsSubVersion);
+        raw.insert(QStringLiteral("bpm_locked"), source.bpmLocked);
+        for (const auto& analysis : source.analyses) {
+            const QString prefix = analysis.type == 2 ? QStringLiteral("summary_") : QStringLiteral("waveform_");
+            raw.insert(prefix + QStringLiteral("id"), double(analysis.id));
+            raw.insert(prefix + QStringLiteral("version"), analysis.version);
+            raw.insert(prefix + QStringLiteral("description"), analysis.description);
+            raw.insert(prefix + QStringLiteral("checksum"), double(analysis.checksum));
+        }
+        track.rawMetadata = raw;
+        if (!catalog->insertTrack(std::move(track))) {
+            catalog->appendDiagnostic(QStringLiteral("Track %1 omitted: catalog identity/path conflict").arg(source.id));
+        }
+    }
+
+    quint32 playlistId = 1;
+    for (const auto& list : stick.playlists) {
+        RuntimePlaylistNode node;
+        node.rekordboxId = playlistId++;
+        node.name = list.name;
+        node.sortOrder = node.rekordboxId;
+        for (const auto trackId : list.trackIds) node.trackIds.append(static_cast<quint32>(trackId));
+        if (!catalog->insertPlaylist(std::move(node))) catalog->appendDiagnostic(QStringLiteral("Playlist %1 skipped").arg(list.name));
+    }
+    if (!stick.crates.isEmpty()) {
+        RuntimePlaylistNode folder;
+        folder.rekordboxId = kMixmanCratesFolderId;
+        folder.name = QStringLiteral("CRATES");
+        folder.isFolder = true;
+        folder.sortOrder = kMixmanCratesFolderId;
+        quint32 crateId = kMixmanCrateBase;
+        for (const auto& list : stick.crates) {
+            RuntimePlaylistNode node;
+            node.rekordboxId = crateId++;
+            node.name = list.name;
+            node.sortOrder = node.rekordboxId;
+            for (const auto trackId : list.trackIds) node.trackIds.append(static_cast<quint32>(trackId));
+            folder.children.append(std::move(node));
+        }
+        if (!catalog->insertPlaylist(std::move(folder))) catalog->appendDiagnostic(QStringLiteral("Crates folder skipped"));
+    }
+    if (!catalog->seal()) {
+        if (error) *error = QStringLiteral("Cannot seal the MIXMAN catalog");
+        return false;
+    }
+    return true;
+}
+
+// Beats and the stored waveform of a stick track, applied to the temporary
+// track the browser loads (cues and metadata come from the runtime track).
+inline void applyMixmanExtras(const QString& root, const RuntimeTrack& runtime, const TrackPointer& track) {
+    if (!track || !isMixmanTrack(runtime)) return;
+    const auto& raw = runtime.rawMetadata;
+    const QByteArray beats = QByteArray::fromBase64(raw.value(QStringLiteral("beats")).toString().toLatin1());
+    const QString version = raw.value(QStringLiteral("beats_version")).toString();
+    if (!beats.isEmpty() && !version.isEmpty()) {
+        track->tryImportBeats(std::make_shared<MixmanBeatsImporter>(beats, version,
+                                      raw.value(QStringLiteral("beats_sub_version")).toString()),
+                raw.value(QStringLiteral("bpm_locked")).toBool());
+    }
+    const auto load = [&](const QString& prefix) -> ConstWaveformPointer {
+        const qint64 id = qint64(raw.value(prefix + QStringLiteral("id")).toDouble(-1));
+        if (id < 0) return {};
+        QFile file(mixman::analysisFilePath(root, id));
+        if (!file.open(QIODevice::ReadOnly) || file.size() > 64 * 1024 * 1024) return {};
+        const QByteArray compressed = file.readAll();
+        if (qint64(qChecksum(compressed)) != qint64(raw.value(prefix + QStringLiteral("checksum")).toDouble(-1))) return {};
+        const QByteArray data = qUncompress(compressed);
+        if (data.isEmpty()) return {};
+        auto* waveform = new Waveform(data);
+        waveform->setVersion(raw.value(prefix + QStringLiteral("version")).toString());
+        waveform->setDescription(raw.value(prefix + QStringLiteral("description")).toString());
+        return ConstWaveformPointer(waveform);
+    };
+    if (const auto waveform = load(QStringLiteral("waveform_"))) track->setWaveform(waveform);
+    if (const auto summary = load(QStringLiteral("summary_"))) track->setWaveformSummary(summary);
+    track->markClean();
+}
+
+} // namespace mixxx::rekordbox
