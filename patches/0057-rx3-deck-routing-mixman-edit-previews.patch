+    raw.insert(QStringLiteral("beats_version"), edit.beatsVersion);
+    raw.insert(QStringLiteral("beats_sub_version"), edit.beatsSubVersion);
+    raw.insert(QStringLiteral("bpm_locked"), edit.bpmLocked);
+    return raw;
+}
+
+// GUI thread: read what the stick stores from the loaded deck track.
+inline mixman::Edit captureMixmanEdit(const TrackPointer& track, quint32 id, QString* error) {
+    mixman::Edit edit;
+    if (!track) {
+        if (error) *error = QStringLiteral("Load a stick track before saving.");
+        return edit;
+    }
+    edit.trackId = id;
+    edit.bpm = track->getBpm();
+    if (track->getSampleRate().isValid()) edit.sampleRate = track->getSampleRate().value();
+    edit.bpmLocked = track->isBpmLocked();
+    if (const auto beats = track->getBeats()) {
+        edit.beats = beats->toByteArray();
+        edit.beatsVersion = beats->getVersion();
+        edit.beatsSubVersion = beats->getSubVersion();
+    }
+    if (const auto color = track->getColor()) edit.color = quint32(*color) & 0xFFFFFF;
+    edit.rating = track->getRating();
+    const auto main = track->getMainCuePosition();
+    if (main.isValid()) edit.mainCue = main.toEngineSamplePosMaybeInvalid();
+    for (const auto& cue : track->getCuePoints()) {
+        const auto type = cue->getType();
+        mixman::Cue out;
+        out.label = cue->getLabel();
+        out.color = quint32(mixxx::RgbColor::code_t(cue->getColor())) & 0xFFFFFF;
+        out.position = cue->getPosition().toEngineSamplePosMaybeInvalid();
+        if (out.position < 0) continue;
+        const int slot = cue->getHotCue();
+        if (type == CueType::HotCue && slot >= 0) {
+            out.type = 1;
+            out.hotcue = slot;
+        } else if (type == CueType::Loop || type == CueType::MemoryLoop || type == CueType::ActiveLoop) {
+            out.type = 4;
+            out.hotcue = type == CueType::Loop ? slot : -1;
+            out.length = cue->getEndPosition().toEngineSamplePosMaybeInvalid() - out.position;
+            if (out.length <= 0) continue;
+        } else {
+            continue; // main cue is stored separately; extra memory cues have no stick representation
+        }
+        edit.cues.append(std::move(out));
+    }
+    return edit;
+}
