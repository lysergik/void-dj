+// One track's editable performance data, as saved from the deck.
+struct Edit {
+    qint64 trackId{0};
+    double bpm{0};
+    double sampleRate{44100};
+    bool bpmLocked{false};
+    double mainCue{-1}; // engine samples, -1 = none
+    QByteArray beats;
+    QString beatsVersion;
+    QString beatsSubVersion;
+    QList<Cue> cues;    // hot cues and loops (the main cue lives in `mainCue`)
+    std::optional<quint32> color;
+    std::optional<int> rating;
+    bool ratingOnly{false}; // leave grid/cues untouched
+};
+
+// Persist an edit into MIXMAN/library.sqlite in one transaction.
+inline bool write(const QString& root, const Edit& edit, QString* error) {
+    const QString path = databasePath(root);
+    if (path.isEmpty()) {
+        if (error) *error = QStringLiteral("No MIXMAN export found");
+        return false;
+    }
+    const QString connection = QStringLiteral("rx3-mixman-w-") + QUuid::createUuid().toString(QUuid::WithoutBraces);
+    bool ok = false;
+    {
+        QSqlDatabase db = QSqlDatabase::addDatabase(QStringLiteral("QSQLITE"), connection);
+        db.setDatabaseName(path);
+        if (!db.open()) {
+            if (error) *error = db.lastError().text();
+        } else {
+            ok = [&]() -> bool {
+                const auto fail = [&](const QSqlQuery& q) {
+                    if (error) *error = q.lastError().text();
+                    db.rollback();
+                    return false;
+                };
+                if (!db.transaction()) {
+                    if (error) *error = db.lastError().text();
+                    return false;
+                }
+                QSqlQuery q(db);
+                if (edit.ratingOnly) {
+                    q.prepare(QStringLiteral("UPDATE library SET rating=? WHERE id=?"));
+                    q.addBindValue(edit.rating.value_or(0));
+                    q.addBindValue(edit.trackId);
+                    if (!q.exec()) return fail(q);
+                    if (!db.commit()) {
+                        if (error) *error = db.lastError().text();
+                        db.rollback();
+                        return false;
+                    }
+                    return true;
+                }
+                q.prepare(QStringLiteral(
+                        "UPDATE library SET bpm=?, bpm_lock=?, cuepoint=?, beats=?, beats_version=?, "
+                        "beats_sub_version=?, color=?, rating=COALESCE(?, rating) WHERE id=?"));
+                q.addBindValue(edit.bpm);
+                q.addBindValue(edit.bpmLocked ? 1 : 0);
+                q.addBindValue(edit.mainCue >= 0 ? QVariant(qlonglong(edit.mainCue)) : QVariant(QMetaType(QMetaType::LongLong)));
+                q.addBindValue(edit.beats.isEmpty() ? QVariant(QMetaType(QMetaType::QByteArray)) : QVariant(edit.beats));
+                q.addBindValue(edit.beats.isEmpty() ? QVariant(QMetaType(QMetaType::QString)) : QVariant(edit.beatsVersion));
+                q.addBindValue(edit.beats.isEmpty() ? QVariant(QMetaType(QMetaType::QString)) : QVariant(edit.beatsSubVersion));
+                q.addBindValue(edit.color ? QVariant(qlonglong(*edit.color)) : QVariant(QMetaType(QMetaType::LongLong)));
+                q.addBindValue(edit.rating ? QVariant(*edit.rating) : QVariant(QMetaType(QMetaType::Int)));
+                q.addBindValue(edit.trackId);
+                if (!q.exec()) return fail(q);
+                if (q.numRowsAffected() < 1) {
+                    if (error) *error = QStringLiteral("Track is not on the stick");
+                    db.rollback();
+                    return false;
+                }
+                QSqlQuery del(db);
+                del.prepare(QStringLiteral("DELETE FROM cues WHERE track_id=?"));
+                del.addBindValue(edit.trackId);
+                if (!del.exec()) return fail(del);
+                QSqlQuery ins(db);
+                ins.prepare(QStringLiteral(
+                        "INSERT INTO cues(track_id,type,position,length,hotcue,label,color) VALUES(?,?,?,?,?,?,?)"));
+                for (const auto& cue : edit.cues) {
+                    ins.addBindValue(edit.trackId);
+                    ins.addBindValue(cue.type);
+                    ins.addBindValue(qlonglong(cue.position));
+                    ins.addBindValue(qlonglong(cue.length));
+                    ins.addBindValue(cue.hotcue);
+                    ins.addBindValue(cue.label);
+                    ins.addBindValue(cue.color ? QVariant(qlonglong(*cue.color)) : QVariant(QMetaType(QMetaType::LongLong)));
+                    if (!ins.exec()) return fail(ins);
+                }
+                if (!db.commit()) {
+                    if (error) *error = db.lastError().text();
+                    db.rollback();
+                    return false;
+                }
+                return true;
+            }();
             db.close();
         }
     }
