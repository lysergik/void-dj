+bool RuntimeCatalog::updateMixman(quint32 id, const QList<RuntimeCue>& cues, double bpm, const QJsonObject& raw, int rating) {
+    const std::lock_guard<std::mutex> lock(m_mutex);
+    auto it = m_tracks.find(id);
+    if (!m_valid || it == m_tracks.end()) return false;
+    it->cues = cues;
+    if (bpm > 0) it->bpm = bpm;
+    it->rawMetadata = raw;
+    if (rating >= 0 && rating <= 5) it->rating = quint32(rating);
+    return true;
