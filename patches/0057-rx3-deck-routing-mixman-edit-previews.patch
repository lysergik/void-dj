+// A stored Mixxx waveform (prefix "waveform_" or "summary_") of a stick track,
+// read from MIXMAN/analysis after verifying its checksum.
+inline ConstWaveformPointer loadMixmanWaveform(const QString& root, const QJsonObject& raw, const QString& prefix) {
+    const qint64 id = qint64(raw.value(prefix + QStringLiteral("id")).toDouble(-1));
+    if (id < 0) return {};
+    QFile file(mixman::analysisFilePath(root, id));
+    if (!file.open(QIODevice::ReadOnly) || file.size() > 64 * 1024 * 1024) return {};
+    const QByteArray compressed = file.readAll();
+    if (qint64(qChecksum(compressed)) != qint64(raw.value(prefix + QStringLiteral("checksum")).toDouble(-1))) return {};
+    const QByteArray data = qUncompress(compressed);
+    if (data.isEmpty()) return {};
+    auto* waveform = new Waveform(data);
+    waveform->setVersion(raw.value(prefix + QStringLiteral("version")).toString());
+    waveform->setDescription(raw.value(prefix + QStringLiteral("description")).toString());
+    return ConstWaveformPointer(waveform);
+}
+
+// The browser PREVIEW column draws WaveformSeries; a stick stores Mixxx's own
+// summary, so convert that (same data STORAGE thumbnails use).
+inline WaveformSeries mixmanPreviewSeries(const QString& root, const QJsonObject& raw) {
+    WaveformSeries series;
+    const auto summary = loadMixmanWaveform(root, raw, QStringLiteral("summary_"));
+    if (!summary || summary->getCompletion() <= 1) return series;
+    const int count = qMin(summary->getCompletion(), summary->getDataSize());
+    series.columns.reserve(count);
+    for (int i = 0; i < count; ++i) {
+        WaveformColumn column;
+        column.all = quint8(summary->getAll(i));
+        column.low = quint8(summary->getLow(i));
+        column.mid = quint8(summary->getMid(i));
+        column.high = quint8(summary->getHigh(i));
+        series.columns.append(column);
+    }
+    series.tag = QByteArrayLiteral("MIXMAN");
+    return series;
+}
