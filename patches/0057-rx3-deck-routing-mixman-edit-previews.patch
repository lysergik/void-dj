+    if (edit.ratingOnly) {
+        m_catalog->updateRating(quint32(edit.trackId), edit.rating.value_or(0));
+        return {};
+    }
+    m_catalog->updateMixman(quint32(edit.trackId),
+            mixmanRuntimeCues(edit.cues, edit.mainCue, edit.sampleRate > 0 ? edit.sampleRate : 44100),
+            edit.bpm, mixmanBeatsRaw(track->rawMetadata, edit), edit.rating.value_or(-1));
