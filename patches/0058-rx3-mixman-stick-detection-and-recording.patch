+++ b/src/library/mixman/mixmanstick.h
@@ -94,6 +94,25 @@ inline QString databasePath(const QString& root) {
     return candidate;
 }
 
+// A real rekordbox export. It wins over MIXMAN: a stray PIONEER folder (for
+// example one created by a recording) must not hide a MIXMAN stick, and a
+// MIXMAN folder must not hide a genuine rekordbox export.
+inline bool hasRekordboxExport(const QString& root) {
+    if (root.isEmpty()) return false;
+    for (const QString& relative : {QStringLiteral("PIONEER/rekordbox/export.pdb"),
+                 QStringLiteral(".PIONEER/rekordbox/export.pdb")}) {
+        const QFileInfo info(QDir(root).filePath(relative));
+        if (info.isFile()) return true;
+    }
+    return false;
+}
+
+// True when the stick is a mixman export: MIXMAN/library.sqlite and no
+// rekordbox export.pdb. The presence of a PIONEER folder is irrelevant.
+inline bool isMixmanStick(const QString& root) {
+    return !databasePath(root).isEmpty() && !hasRekordboxExport(root);
+}
+
 inline QString analysisFilePath(const QString& root, qint64 id) {
     return QDir(root).filePath(QStringLiteral("MIXMAN/analysis/") + QString::number(id));
 }
