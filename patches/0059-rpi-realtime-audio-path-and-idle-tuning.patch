new file mode 100644
index 0000000..bd775e2
--- /dev/null
+++ b/src/util/rtscheduling.h
@@ -0,0 +1,61 @@
+#pragma once
+
+namespace mixxx {
+
+// Scheduling ladder for the latency-critical threads on Linux (Raspberry Pi).
+//
+// The audio callback must preempt everything else in the app, the two hops
+// between the callback and the disk (EngineWorkerScheduler -> CachingReader
+// worker) must preempt the GUI and library threads, and everything left on
+// SCHED_OTHER (analysis, library workers) must never delay them. All values are
+// below the audio/USB IRQ threads of a PREEMPT_RT / threadirqs kernel.
+//
+// Everything here is best-effort: it needs an rtprio rlimit or CAP_SYS_NICE
+// and silently degrades to the default scheduler when that is not granted.
+// Set NAUTICMIXXX_RT=0 to disable every promotion.
+constexpr int kRtPrioAudioEngine = 70;
+// SCHED_FIFO only preempts *strictly* lower priorities, so the scheduler sits
+// one rung above the reader it wakes: a wake-up for the next chunk never waits
+// behind the decode of the current one on the same core.
+constexpr int kRtPrioEngineWorkerScheduler = 62;
+constexpr int kRtPrioTrackReader = 60;
+// Opt-in only (NAUTICMIXXX_RT_MAIN=1), see promoteMainThreadIfRequested().
+constexpr int kRtPrioMainThread = 49;
+
+/// Best-effort promotion of the calling thread to SCHED_FIFO on Linux. QThread
+/// priorities are no-ops under SCHED_OTHER, so the threads feeding the audio
+/// callback need a real-time policy to reliably preempt GUI rendering. Logs a
+/// single warning the first time a promotion is refused. Returns false (no-op)
+/// on other platforms, when disabled through NAUTICMIXXX_RT=0, or when refused.
+bool promoteCurrentThreadToRealtime(int priority, const char* threadName);
+
+/// Switch the calling thread between SCHED_FIFO at `priority` (realtime) and
+/// plain SCHED_OTHER, silently. For a thread that changes class per work item.
+bool setCurrentThreadRealtimeQuietly(bool realtime, int priority);
+
+/// Demote the calling thread to background work: nice 19 under SCHED_BATCH and
+/// the weakest best-effort I/O priority. For long CPU-bound jobs (track
+/// analysis) that share cores with the threads that feed the audio callback.
+/// Needs no privileges. Deliberately not SCHED_IDLE: analyzers hold track
+/// cache / database locks the reader also takes, and SCHED_IDLE could leave a
+/// lock holder starved behind a busy thread (priority inversion).
+bool demoteCurrentThreadToBackground(const char* threadName);
+
+/// Pin the calling thread to the CPU number named by environment variable
+/// `envVar`, if it is set. Allocation-free, so it can run in the audio callback.
+bool pinCurrentThreadToCpuFromEnv(const char* envVar, const char* threadName);
+
+/// Lock process memory (mlockall, MCL_ONFAULT) so the audio callback never
+/// major-faults executable pages back in from the SD card under memory
+/// pressure. Only done when the memlock rlimit is unlimited (what the `audio`
+/// group's limits.d file grants) so it can never fail half-way or pin more
+/// than the user allowed. NAUTICMIXXX_MLOCK=0 disables it.
+bool lockAllMemoryIfPermitted();
+
+/// Promote the calling (GUI) thread when NAUTICMIXXX_RT_MAIN=1 is set. Off by
+/// default: a desktop compositor shares the machine, and a SCHED_FIFO GUI thread
+/// is only appropriate on a dedicated DJ unit. Also caps the global thread pool
+/// to SCHED_OTHER so pool threads do not inherit the RT policy.
+bool promoteMainThreadIfRequested();
+
+} // namespace mixxx
