diff --git a/src/util/rtscheduling.cpp b/src/util/rtscheduling.cpp
new file mode 100644
index 0000000..e4a5ffd
--- /dev/null
+++ b/src/util/rtscheduling.cpp
@@ -0,0 +1,173 @@
+#include "util/rtscheduling.h"
+
+#include <QThread>
+#include <QThreadPool>
+#include <QtDebug>
+#include <atomic>
+
+#ifdef __LINUX__
+#include <pthread.h>
+#include <sched.h>
+#include <sys/mman.h>
+#include <sys/resource.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+#include <cerrno>
+#include <cstdlib>
+#include <cstring>
+#endif
+
+namespace mixxx {
+
+#ifdef __LINUX__
+namespace {
+
+constexpr int kNiceLowest = 19;
+
+// ioprio_set(2) has no glibc wrapper. who == 0 is the calling thread.
+constexpr int kIoprioWhoProcess = 1;
+constexpr int kIoprioClassShift = 13;
+constexpr int kIoprioClassBestEffort = 2;
+constexpr int kIoprioBestEffortLowest = 7;
+
+bool envIsFalse(const char* name) {
+    const char* value = std::getenv(name);
+    return value != nullptr && std::strcmp(value, "0") == 0;
+}
+
+bool envIsTrue(const char* name) {
+    const char* value = std::getenv(name);
+    return value != nullptr && std::strcmp(value, "1") == 0;
+}
+
+std::atomic<bool> s_warnedAboutRealtime{false};
+
+} // namespace
+#endif
+
+bool promoteCurrentThreadToRealtime(int priority, const char* threadName) {
+#ifdef __LINUX__
+    if (envIsFalse("NAUTICMIXXX_RT")) {
+        return false;
+    }
+    sched_param param{};
+    param.sched_priority = priority;
+    const int err = pthread_setschedparam(pthread_self(), SCHED_FIFO, &param);
+    if (err == 0) {
+        qInfo() << "Thread" << threadName
+                << "scheduled with SCHED_FIFO priority" << priority;
+        return true;
+    }
+    if (!s_warnedAboutRealtime.exchange(true)) {
+        qWarning() << "Could not use real-time scheduling for thread"
+                   << threadName << ":" << strerror(err)
+                   << "- add your user to the audio group / raise the rtprio"
+                      " rlimit (see docs/LINUX-RASPBERRY-PI.md)";
+    }
+    return false;
+#else
+    Q_UNUSED(priority);
+    Q_UNUSED(threadName);
+    return false;
+#endif
+}
+
+bool setCurrentThreadRealtimeQuietly(bool realtime, int priority) {
+#ifdef __LINUX__
+    sched_param param{};
+    param.sched_priority = realtime ? priority : 0;
+    return pthread_setschedparam(pthread_self(),
+                   realtime ? SCHED_FIFO : SCHED_OTHER,
+                   &param) == 0;
+#else
+    Q_UNUSED(realtime);
+    Q_UNUSED(priority);
+    return false;
+#endif
+}
+
+bool demoteCurrentThreadToBackground(const char* threadName) {
+#ifdef __LINUX__
+    bool batched = false;
+#ifdef SCHED_BATCH
+    sched_param param{};
+    param.sched_priority = 0;
+    batched = pthread_setschedparam(pthread_self(), SCHED_BATCH, &param) == 0;
+#endif
+    // Nice values are per-thread on Linux (who == 0 is the calling thread).
+    const bool reniced = setpriority(PRIO_PROCESS, 0, kNiceLowest) == 0;
+    if (!batched && !reniced) {
+        return false;
+    }
+    constexpr int ioprio =
+            (kIoprioClassBestEffort << kIoprioClassShift) | kIoprioBestEffortLowest;
+    syscall(SYS_ioprio_set, kIoprioWhoProcess, 0, ioprio); // best effort
+    qInfo() << "Thread" << threadName << "scheduled as background work";
+    return true;
+#else
+    Q_UNUSED(threadName);
+    return false;
+#endif
+}
+
+bool pinCurrentThreadToCpuFromEnv(const char* envVar, const char* threadName) {
+#ifdef __LINUX__
+    // Plain getenv/strtol, no QByteArray: this may run inside the first audio
+    // callback and must not allocate.
+    const char* value = std::getenv(envVar);
+    if (value == nullptr || *value == '\0') {
+        return false;
+    }
+    char* end = nullptr;
+    const long cpu = std::strtol(value, &end, 10);
+    if (end == value || *end != '\0' || cpu < 0 || cpu >= CPU_SETSIZE) {
+        return false;
+    }
+    cpu_set_t set;
+    CPU_ZERO(&set);
+    CPU_SET(static_cast<int>(cpu), &set);
+    return pthread_setaffinity_np(pthread_self(), sizeof(set), &set) == 0;
+#else
+    Q_UNUSED(envVar);
+    Q_UNUSED(threadName);
+    return false;
+#endif
+}
+
+bool lockAllMemoryIfPermitted() {
+#ifdef __LINUX__
+    if (envIsFalse("NAUTICMIXXX_MLOCK")) {
+        return false;
+    }
+    rlimit limit{};
+    if (getrlimit(RLIMIT_MEMLOCK, &limit) != 0 || limit.rlim_cur != RLIM_INFINITY) {
+        return false;
+    }
+#ifdef MCL_ONFAULT
+    if (mlockall(MCL_CURRENT | MCL_FUTURE | MCL_ONFAULT) == 0) {
+        qInfo() << "Locked process memory (mlockall, on fault)";
+        return true;
+    }
+#endif
+    return false;
+#else
+    return false;
+#endif
+}
+
+bool promoteMainThreadIfRequested() {
+#ifdef __LINUX__
+    if (!envIsTrue("NAUTICMIXXX_RT_MAIN")) {
+        return false;
+    }
+    // Threads spawned from an RT thread inherit its policy unless QThread gives
+    // them an explicit priority; keep QtConcurrent's pool on SCHED_OTHER.
+    QThreadPool::globalInstance()->setThreadPriority(QThread::NormalPriority);
+    return promoteCurrentThreadToRealtime(kRtPrioMainThread, "Main");
+#else
+    return false;
+#endif
+}
+
+} // namespace mixxx
