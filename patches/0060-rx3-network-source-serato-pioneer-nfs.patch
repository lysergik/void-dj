+// Reads the export. A stick left with a hot rollback journal (pulled right
+// after a save) or on a read-only mount cannot be opened read-only in place, so
+// fall back to a private copy where SQLite may recover; the stick stays untouched.
+inline bool read(const QString& root, Stick* stick, QString* error) {
+    const QString path = databasePath(root);
+    if (path.isEmpty()) {
+        if (error) *error = QStringLiteral("No MIXMAN export found");
+        return false;
+    }
+    QString firstError;
+    *stick = Stick();
+    if (readDatabase(root, path, true, stick, &firstError)) return true;
+    QTemporaryDir dir;
+    if (dir.isValid()) {
+        const QString copy = dir.filePath(QStringLiteral("library.sqlite"));
+        bool copied = QFile::copy(path, copy);
+        for (const char* suffix : {"-journal", "-wal"}) {
+            if (QFileInfo::exists(path + QLatin1String(suffix))) QFile::copy(path + QLatin1String(suffix), copy + QLatin1String(suffix));
+        }
+        QString copyError;
+        *stick = Stick();
+        if (copied && readDatabase(root, copy, false, stick, &copyError)) {
+            stick->databasePath = path;
+            return true;
+        }
+    }
+    if (error) *error = firstError;
+    return false;
+}
