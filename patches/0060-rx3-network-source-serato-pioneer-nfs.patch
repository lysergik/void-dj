diff --git a/b/src/library/serato/seratostick.h b/src/library/serato/seratostick.h
new file mode 100644
index 0000000..edc6494
--- /dev/null
+++ b/src/library/serato/seratostick.h
@@ -0,0 +1,185 @@
+#pragma once
+
+// Serato USB drives as a SOURCE (read-only). A drive written by Serato DJ holds
+//
+//   <drive>/_Serato_/database V2        chunked big-endian records, UTF-16BE text
+//   <drive>/_Serato_/Subcrates/*.crate  one crate per file ("Parent%%Child" nests)
+//
+// Track paths are stored relative to the drive root. The reader produces the same
+// plain-data `mixman::Stick` the MIXMAN reader does, so the existing runtime
+// catalog, browse categories and deck loading serve both. Cue points and grids
+// live inside the audio files' tags (Serato Markers2 / BeatGrid) and are read
+// by Mixxx's own tag import when a track is loaded; this reader only supplies
+// the library view (tags, key, BPM, crates).
+
+#include <QByteArray>
+#include <QDir>
+#include <QFile>
+#include <QFileInfo>
+#include <QHash>
+#include <QSet>
+#include <QString>
+#include <QtEndian>
+
+#include <cstring>
+
+#include "library/mixman/mixmanstick.h"
+
+namespace mixxx::seratostick {
+
+constexpr qint64 kMaxDatabaseBytes = Q_INT64_C(512) << 20;
+constexpr qint64 kMaxCrateBytes = Q_INT64_C(64) << 20;
+
+inline QString databasePath(const QString& root) {
+    if (root.isEmpty()) return {};
+    const QString candidate = QDir(root).filePath(QStringLiteral("_Serato_/database V2"));
+    const QFileInfo info(candidate);
+    if (!info.isFile() || info.isSymLink()) return {};
+    const QString canonicalRoot = QFileInfo(root).canonicalFilePath();
+    const QString canonical = info.canonicalFilePath();
+    if (canonicalRoot.isEmpty() || !canonical.startsWith(canonicalRoot + QLatin1Char('/'))) return {};
+    return candidate;
+}
+
+namespace detail {
+
+inline QString utf16be(const QByteArray& data) {
+    QString text;
+    text.reserve(data.size() / 2);
+    for (int i = 0; i + 1 < data.size(); i += 2) {
+        text.append(QChar(quint16((quint8(data[i]) << 8) | quint8(data[i + 1]))));
+    }
+    return text;
+}
+
+constexpr quint32 tag(const char (&name)[5]) {
+    return (quint32(quint8(name[0])) << 24) | (quint32(quint8(name[1])) << 16) |
+            (quint32(quint8(name[2])) << 8) | quint32(quint8(name[3]));
+}
+
+// Walk the records of a chunk; `visit(id, payload)` returns false to stop.
+template<typename Visit>
+inline bool forEachRecord(const QByteArray& data, Visit&& visit) {
+    qint64 offset = 0;
+    while (offset + 8 <= data.size()) {
+        const quint32 id = qFromBigEndian<quint32>(data.constData() + offset);
+        const quint32 length = qFromBigEndian<quint32>(data.constData() + offset + 4);
+        offset += 8;
+        if (qint64(length) > data.size() - offset) return false; // truncated record
+        if (!visit(id, QByteArray::fromRawData(data.constData() + offset, int(length)))) return true;
+        offset += length;
+    }
+    return offset == data.size();
+}
+
+inline QString cleanPath(QString path) {
+    path.replace(QLatin1Char('\\'), QLatin1Char('/'));
+    while (path.startsWith(QLatin1Char('/'))) path.remove(0, 1);
+    return path;
+}
+
+// Serato writes lengths as "mm:ss.cc" text.
+inline double parseLength(const QString& text) {
+    const QString trimmed = text.trimmed();
+    if (trimmed.isEmpty()) return 0;
+    if (!trimmed.contains(QLatin1Char(':'))) return trimmed.toDouble();
+    double seconds = 0;
+    for (const QString& part : trimmed.split(QLatin1Char(':'))) seconds = seconds * 60 + part.toDouble();
+    return seconds;
+}
+
+} // namespace detail
+
+inline bool read(const QString& root, mixman::Stick* stick, QString* error) {
+    const QString path = databasePath(root);
+    if (path.isEmpty()) {
+        if (error) *error = QStringLiteral("No Serato database found");
+        return false;
+    }
+    QFile file(path);
+    if (!file.open(QIODevice::ReadOnly) || file.size() > kMaxDatabaseBytes) {
+        if (error) *error = QStringLiteral("Cannot read the Serato database");
+        return false;
+    }
+    const QByteArray data = file.readAll();
+    stick->root = root;
+    stick->databasePath = path;
+    stick->exportId = QStringLiteral("serato");
+    stick->createdUnix = QFileInfo(path).lastModified().toSecsSinceEpoch();
+
+    QHash<QString, qint64> byPath;      // exact relative path -> id
+    QHash<QString, qint64> byLowerPath; // case-insensitive fallback (FAT/exFAT drives)
+    qint64 nextId = 1;
+    const bool wellFormed = detail::forEachRecord(data, [&](quint32 id, const QByteArray& payload) {
+        if (id != detail::tag("otrk")) return true;
+        mixman::Track track;
+        bool missing = false;
+        detail::forEachRecord(payload, [&](quint32 field, const QByteArray& value) {
+            const auto text = [&] { return detail::utf16be(value); };
+            switch (field) {
+            case detail::tag("pfil"): track.relativePath = detail::cleanPath(text()); break;
+            case detail::tag("tsng"): track.title = text(); break;
+            case detail::tag("tart"): track.artist = text(); break;
+            case detail::tag("talb"): track.album = text(); break;
+            case detail::tag("tgen"): track.genre = text(); break;
+            case detail::tag("tcom"): track.comment = text(); break;
+            case detail::tag("tgrp"): track.grouping = text(); break;
+            case detail::tag("ttyr"): track.year = text().trimmed(); break;
+            case detail::tag("tkey"): track.key = text().trimmed(); break;
+            case detail::tag("tbpm"): track.bpm = text().trimmed().toDouble(); break;
+            case detail::tag("tlen"): track.duration = detail::parseLength(text()); break;
+            case detail::tag("tsmp"): track.samplerate = int(text().trimmed().toDouble()); break;
+            case detail::tag("bbgl"): track.bpmLocked = !value.isEmpty() && value.at(0) != 0; break;
+            case detail::tag("bmis"): missing = value.size() == 1 && value.at(0) != 0; break;
+            default: break;
+            }
+            return true;
+        });
+        if (track.relativePath.isEmpty() || track.relativePath.contains(QStringLiteral(".."))) return true;
+        // Serato keeps entries for files it cannot find; they cannot be played.
+        if (missing && !QFileInfo::exists(QDir(root).filePath(track.relativePath))) return true;
+        if (track.title.isEmpty()) track.title = QFileInfo(track.relativePath).completeBaseName();
+        track.id = nextId++;
+        byPath.insert(track.relativePath, track.id);
+        byLowerPath.insert(track.relativePath.toLower(), track.id);
+        stick->tracks.append(std::move(track));
+        return true;
+    });
+    if (!wellFormed && stick->tracks.isEmpty()) {
+        if (error) *error = QStringLiteral("The Serato database is damaged");
+        return false;
+    }
+
+    // Crates: "Techno%%Peak.crate" is "Techno / Peak".
+    const QDir crateDir(QDir(root).filePath(QStringLiteral("_Serato_/Subcrates")));
+    qint64 crateId = 1;
+    for (const QFileInfo& entry : crateDir.entryInfoList({QStringLiteral("*.crate")}, QDir::Files, QDir::Name | QDir::IgnoreCase)) {
+        if (entry.isSymLink() || entry.size() > kMaxCrateBytes) continue;
+        QFile crateFile(entry.absoluteFilePath());
+        if (!crateFile.open(QIODevice::ReadOnly)) continue;
+        const QByteArray crateData = crateFile.readAll();
+        mixman::List list;
+        QSet<qint64> members;
+        list.id = crateId++;
+        list.name = entry.completeBaseName().replace(QStringLiteral("%%"), QStringLiteral(" / "));
+        detail::forEachRecord(crateData, [&](quint32 id, const QByteArray& payload) {
+            if (id != detail::tag("otrk")) return true;
+            detail::forEachRecord(payload, [&](quint32 field, const QByteArray& value) {
+                if (field != detail::tag("ptrk")) return true;
+                const QString relative = detail::cleanPath(detail::utf16be(value));
+                qint64 trackId = byPath.value(relative, 0);
+                if (trackId == 0) trackId = byLowerPath.value(relative.toLower(), 0);
+                if (trackId != 0 && !members.contains(trackId)) {
+                    members.insert(trackId);
+                    list.trackIds.append(trackId);
+                }
+                return true;
+            });
