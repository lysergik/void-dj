diff --git a/b/src/library/network/networkmanager.h b/src/library/network/networkmanager.h
new file mode 100644
index 0000000..5b687df
--- /dev/null
+++ b/src/library/network/networkmanager.h
@@ -0,0 +1,696 @@
+#pragma once
+
+// SOURCE > NETWORK. Tracks the remote libraries this machine can see (other
+// NauticMixxx instances through the NMX share protocol, Pioneer players through
+// Pro DJ Link) and gives each one a local cache directory laid out like a USB
+// stick (MIXMAN/... or PIONEER/...), so the normal source machinery can browse,
+// load and import it. Library files arrive up front, audio and per-track
+// analysis on demand (ensureFile), always read-only.
+
+#include <QDir>
+#include <QHostInfo>
+#include <QNetworkDatagram>
+#include <QFile>
+#include <QFileInfo>
+#include <QHash>
+#include <QJsonDocument>
+#include <QJsonObject>
+#include <QMutex>
+#include <QMutexLocker>
+#include <QObject>
+#include <QSqlDatabase>
+#include <QSqlQuery>
+#include <QThread>
+#include <QTimer>
+#include <QUdpSocket>
+#include <QUuid>
+#include <QtConcurrentRun>
+
+#include <functional>
+#include <memory>
+#include <optional>
+
+#include "library/network/nmxhttp.h"
+#include "library/network/nmxshare.h"
+#include "library/network/prolinkdiscovery.h"
+#include "library/network/prolinknfs.h"
+#include "library/rekordbox/rekordboxdatabase.h"
+#include "preferences/usersettings.h"
+
+namespace mixxx::network {
+
+enum class Protocol { Nautic, Pioneer };
+
+struct NetSource {
+    QString key;            // "nautic-<id>" or "pioneer-<ip>"
+    Protocol protocol{Protocol::Nautic};
+    QString name;
+    QString host;
+    quint16 port{0};
+    QString root;           // cache directory, laid out like a stick
+    QString state;          // "preparing" | "ready" | "error"
+    QString error;
+    bool auth{false};
+    qint64 lastSeenMs{0};
+    qint64 lastAttemptMs{0};
+    bool manual{false};
+    int generation{0};
+    QString mountPath;      // Pioneer: NFS export of the slot ("/C/" USB, "/B/" SD)
+};
+
+class NetworkManager : public QObject {
+  public:
+    explicit NetworkManager(UserSettingsPointer config, QObject* parent = nullptr)
+            : QObject(parent), m_config(std::move(config)) {
+        m_cacheBase = QDir(m_config->getSettingsPath()).filePath(QStringLiteral("network"));
+        s_instance = this;
+    }
+    ~NetworkManager() override {
+        stop();
+        if (s_instance == this) s_instance = nullptr;
+    }
+    static NetworkManager* instance() { return s_instance; }
+
+    // Called from any thread: is this directory one of the network cache roots?
+    static bool isNetworkRoot(const QString& root) {
+        auto* self = s_instance;
+        if (!self || root.isEmpty()) return false;
+        const QString clean = QDir::cleanPath(root);
+        const QString base = QDir::cleanPath(self->m_cacheBase) + QLatin1Char('/');
+        return clean.startsWith(base);
+    }
+
+    void setChangedCallback(std::function<void()> callback) { m_changed = std::move(callback); }
+
+    // ---- lifecycle (GUI thread) ----
+    void start() {
+        if (m_started) return;
+        m_started = true;
+        QDir(m_cacheBase).removeRecursively(); // the cache is per run
+        QDir().mkpath(m_cacheBase);
+        m_ownId = m_config->getValueString(ConfigKey("[RX3Network]", "id"));
+        if (m_ownId.isEmpty()) {
+            m_ownId = QUuid::createUuid().toString(QUuid::WithoutBraces).left(8);
+            m_config->setValue(ConfigKey("[RX3Network]", "id"), m_ownId);
+        }
+        m_listen = std::make_unique<QUdpSocket>();
+        if (m_listen->bind(QHostAddress::AnyIPv4, kNmxAnnouncePort,
+                    QUdpSocket::ShareAddress | QUdpSocket::ReuseAddressHint)) {
+            QObject::connect(m_listen.get(), &QUdpSocket::readyRead, this, [this] { readAnnouncements(); });
+        } else {
+            qWarning() << "NMX discovery cannot listen on" << kNmxAnnouncePort << m_listen->errorString();
+        }
+        m_prolink = std::make_unique<QUdpSocket>();
+        if (m_prolink->bind(QHostAddress::AnyIPv4, kProLinkPort,
+                    QUdpSocket::ShareAddress | QUdpSocket::ReuseAddressHint)) {
+            QObject::connect(m_prolink.get(), &QUdpSocket::readyRead, this, [this] { readProLink(); });
+        } else {
+            qWarning() << "Pro DJ Link discovery cannot listen on" << kProLinkPort << m_prolink->errorString();
+        }
+        m_tick = std::make_unique<QTimer>();
+        m_tick->setInterval(3000);
+        QObject::connect(m_tick.get(), &QTimer::timeout, this, [this] { tick(); });
+        m_tick->start();
+        applyShareSettings();
+        tick();
+    }
+
+    void stop() {
+        m_tick.reset();
+        m_listen.reset();
+        m_prolink.reset();
+        m_share.reset();
+        m_started = false;
+    }
+
+    // ---- sources ----
+    QList<NetSource> sources() const {
+        QMutexLocker lock(&m_mutex);
+        return m_sources.values();
+    }
+    std::optional<NetSource> sourceForRoot(const QString& root) const {
+        const QString clean = QDir::cleanPath(root);
+        QMutexLocker lock(&m_mutex);
+        for (const auto& source : m_sources) {
+            if (QDir::cleanPath(source.root) == clean) return source;
+        }
+        return std::nullopt;
+    }
+    QStringList readyRoots() const {
+        QStringList roots;
+        QMutexLocker lock(&m_mutex);
+        for (const auto& source : m_sources) {
+            if (source.state == QLatin1String("ready")) roots.append(source.root);
+        }
+        roots.sort();
+        return roots;
+    }
+    QString ownId() const { return m_ownId; }
+
+    // Forget what we know and fetch the library again.
+    void refresh(const QString& key) {
+        {
+            QMutexLocker lock(&m_mutex);
+            auto it = m_sources.find(key);
+            if (it == m_sources.end()) return;
+            it->state = QStringLiteral("preparing");
+            it->error.clear();
+        }
+        notifyChanged();
+        startSync(key);
+    }
+
+    // ---- sharing settings ----
+    bool shareEnabled() const { return m_config->getValue(ConfigKey("[RX3Network]", "share"), false); }
+    void setShareEnabled(bool enabled) {
+        m_config->setValue(ConfigKey("[RX3Network]", "share"), enabled);
+        applyShareSettings();
+    }
+    QString shareName() const {
+        const QString name = m_config->getValueString(ConfigKey("[RX3Network]", "name"));
+        return name.isEmpty() ? QHostInfo::localHostName() : name;
+    }
+    void setShareName(const QString& name) {
+        m_config->setValue(ConfigKey("[RX3Network]", "name"), name.trimmed().left(40));
+        applyShareSettings();
+    }
+    // A PIN is up to a handful of characters; "----" (nothing chosen) means no PIN.
+    QString pin() const {
+        const QString value = m_config->getValueString(ConfigKey("[RX3Network]", "pin"));
+        return value.trimmed().remove(QLatin1Char('-')).isEmpty() ? QString() : value;
+    }
+    void setPin(const QString& pin) {
+        m_config->setValue(ConfigKey("[RX3Network]", "pin"), pin);
+        applyShareSettings();
+        // A new PIN may unlock peers that refused the old one.
+        QStringList retry;
+        {
+            QMutexLocker lock(&m_mutex);
+            for (auto& source : m_sources) {
+                if (source.state == QLatin1String("error")) retry.append(source.key);
+            }
+        }
+        for (const auto& key : std::as_const(retry)) refresh(key);
+    }
+    QString shareStatus() const {
+        if (!shareEnabled()) return QStringLiteral("OFF");
+        if (!m_share || !m_share->running()) return QStringLiteral("ERROR: %1").arg(m_shareError);
+        return QStringLiteral("ON, port %1").arg(m_share->port());
+    }
+
+    // ---- on-demand files (any thread except the audio thread) ----
+    bool ensureFile(const QString& root, const QString& relativePath, QString* error = nullptr) {
+        std::optional<NetSource> source = sourceForRoot(root);
+        if (!source) {
+            if (error) *error = QStringLiteral("Not a network source");
+            return false;
+        }
+        if (source->protocol == Protocol::Nautic) return ensureNautic(*source, relativePath, error);
+        if (source->protocol == Protocol::Pioneer) return ensurePioneer(*source, relativePath, error);
+        return ensureExtra ? ensureExtra(*source, relativePath, error) : false;
+    }
+
+    // Hooks other protocols register (Pioneer Pro DJ Link).
+    std::function<bool(const NetSource&, const QString&, QString*)> ensureExtra;
+    // Called by protocol modules to publish a source; GUI thread.
+    void upsertSource(const NetSource& source) {
+        {
+            QMutexLocker lock(&m_mutex);
+            auto it = m_sources.find(source.key);
+            if (it == m_sources.end()) {
+                m_sources.insert(source.key, source);
+            } else {
+                const QString state = it->state, error = it->error, root = it->root;
+                const int generation = it->generation;
+                *it = source;
+                if (source.state.isEmpty()) { it->state = state; it->error = error; }
+                if (source.root.isEmpty()) it->root = root;
+                it->generation = generation;
+            }
+        }
+        notifyChanged();
+    }
+    void updateSource(const QString& key, const std::function<void(NetSource&)>& change) {
+        {
+            QMutexLocker lock(&m_mutex);
+            auto it = m_sources.find(key);
+            if (it == m_sources.end()) return;
+            change(*it);
+        }
+        notifyChanged();
+    }
+    void removeSource(const QString& key) {
+        {
+            QMutexLocker lock(&m_mutex);
+            if (m_sources.remove(key) == 0) return;
+        }
+        notifyChanged();
+    }
+    QString cacheBase() const { return m_cacheBase; }
+    UserSettingsPointer config() const { return m_config; }
+    std::function<void()> extraTick; // other protocols hang their housekeeping here
+
+  private:
+    void notifyChanged() {
+        if (!m_changed) return;
+        if (QThread::currentThread() == thread()) m_changed();
+        else QMetaObject::invokeMethod(this, [this] { if (m_changed) m_changed(); }, Qt::QueuedConnection);
+    }
+
+    void applyShareSettings() {
+        const QString pinValue = pin();
+        if (!shareEnabled()) {
+            m_share.reset();
+            m_shareError.clear();
+            return;
+        }
+        if (!m_share) m_share = std::make_unique<NmxServer>(m_config->getSettingsPath());
+        QString error;
+        const quint16 port = quint16(m_config->getValue(ConfigKey("[RX3Network]", "port"), int(kNmxPort)));
+        if (!m_share->start(m_ownId, shareName(), pinValue, port, &error)) {
+            m_shareError = error;
+            qWarning() << "NMX share cannot start:" << error;
+        } else {
+            m_shareError.clear();
+        }
+    }
+
+    void readAnnouncements() {
+        while (m_listen && m_listen->hasPendingDatagrams()) {
+            const QNetworkDatagram datagram = m_listen->receiveDatagram();
+            const QJsonObject json = QJsonDocument::fromJson(datagram.data()).object();
+            if (json.value("nmx").toInt() != kNmxVersion) continue;
+            const QString id = json.value("id").toString();
+            if (id.isEmpty() || id == m_ownId) continue;
+            QHostAddress address = datagram.senderAddress();
+            bool ok = false;
+            const quint32 v4 = address.toIPv4Address(&ok);
+            const QString host = ok ? QHostAddress(v4).toString() : address.toString();
+            seen(id, json.value("name").toString(), host, quint16(json.value("port").toInt(kNmxPort)),
+                    json.value("auth").toBool(), false);
+        }
+    }
+
+    void readProLink() {
+        while (m_prolink && m_prolink->hasPendingDatagrams()) {
+            const QNetworkDatagram datagram = m_prolink->receiveDatagram();
+            ProLinkDevice device;
+            if (!parseProLinkKeepAlive(datagram.data(), &device)) continue;
+            const qint64 now = QDateTime::currentMSecsSinceEpoch();
+            bool hasSource = false;
+            {
+                QMutexLocker lock(&m_mutex);
+                for (auto& source : m_sources) {
+                    if (source.protocol == Protocol::Pioneer && source.host == device.host) {
+                        source.lastSeenMs = now;
+                        hasSource = true;
+                    }
+                }
+            }
+            // Only players carry media. A player without a readable slot is probed
+            // again every 15 s so a stick inserted later shows up.
+            if (!device.isPlayer() || hasSource) continue;
+            auto& probe = m_pioneerProbe[device.host];
+            if (probe.busy || now - probe.lastMs < 15000) continue;
+            probe.busy = true;
+            probe.lastMs = now;
+            startPioneerProbe(device);
+        }
+    }
+
+    // Look for media in each slot of a player, then copy library + analysis files.
+    void startPioneerProbe(const ProLinkDevice& device) {
+        (void)QtConcurrent::run([this, device] {
+            const QList<QPair<QString, QString>> mediaSlots{{QStringLiteral("C"), QStringLiteral("USB")}, {QStringLiteral("B"), QStringLiteral("SD")}};
+            for (const auto& slot : mediaSlots) {
+                const QString mountPath = QStringLiteral("/%1/").arg(slot.first);
+                NfsClient nfs(device.host);
+                if (!nfs.mount(mountPath)) continue;
+                QString pdb;
+                for (const QString& candidate : {QStringLiteral("PIONEER/rekordbox/export.pdb"), QStringLiteral(".PIONEER/rekordbox/export.pdb")}) {
+                    if (nfs.lookupPath(candidate).ok) { pdb = candidate; break; }
+                }
+                if (pdb.isEmpty()) continue;
+                NetSource source;
+                source.key = QStringLiteral("pioneer-%1-%2").arg(nmxSanitize(device.host, QStringLiteral("device")), slot.first.toLower());
+                source.protocol = Protocol::Pioneer;
+                source.host = device.host;
+                source.mountPath = mountPath;
+                source.name = QStringLiteral("%1%2 %3").arg(device.name,
+                        device.isPlayer() ? QStringLiteral(" P%1").arg(device.number) : QString(),
+                        slot.second);
+                source.root = QDir(m_cacheBase).filePath(source.key);
+                source.state = QStringLiteral("preparing");
+                source.lastSeenMs = QDateTime::currentMSecsSinceEpoch();
+                QMetaObject::invokeMethod(this, [this, source] { upsertSource(source); }, Qt::QueuedConnection);
+                QString error;
+                const bool ok = syncPioneer(source, pdb, &error);
+                QMetaObject::invokeMethod(this, [this, key = source.key, ok, error] {
+                    updateSource(key, [&](NetSource& s) {
+                        s.state = ok ? QStringLiteral("ready") : QStringLiteral("error");
+                        s.error = error;
+                        ++s.generation;
+                    });
+                }, Qt::QueuedConnection);
+            }
+            QMetaObject::invokeMethod(this, [this, host = device.host] {
+                m_pioneerProbe[host].busy = false;
+                m_pioneerProbe[host].lastMs = QDateTime::currentMSecsSinceEpoch();
+            }, Qt::QueuedConnection);
+        });
+    }
+
+    bool fetchPioneerFile(NfsClient& nfs, const NetSource& source, const QString& relative, QString* error) {
+        const QString target = QDir(source.root).filePath(relative);
+        QDir().mkpath(QFileInfo(target).absolutePath());
+        QFile part(target + QStringLiteral(".part"));
+        if (!part.open(QIODevice::WriteOnly | QIODevice::Truncate)) {
+            if (error) *error = QStringLiteral("Cannot write the cache");
+            return false;
+        }
+        if (!nfs.readFile(relative, &part, [this] { return m_started; })) {
+            part.close();
+            part.remove();
+            if (error) *error = nfs.error();
+            return false;
+        }
+        part.close();
+        QFile::remove(target);
+        if (!QFile::rename(part.fileName(), target)) {
+            if (error) *error = QStringLiteral("Cannot publish the cached file");
+            return false;
+        }
+        return true;
+    }
+
+    bool syncPioneer(const NetSource& source, const QString& pdbRelative, QString* error) {
+        NfsClient nfs(source.host);
+        if (!nfs.mount(source.mountPath)) {
+            *error = nfs.error();
+            return false;
+        }
+        QDir().mkpath(source.root);
+        if (!fetchPioneerFile(nfs, source, pdbRelative, error)) return false;
+        const QString extended = QFileInfo(pdbRelative).path() + QStringLiteral("/exportExt.pdb");
+        QString ignored;
+        fetchPioneerFile(nfs, source, extended, &ignored); // optional
+        const auto document = rekordbox::readDatabaseFile(QDir(source.root).filePath(pdbRelative), rekordbox::DatabaseKind::Main);
+        if (!document.valid()) {
+            *error = document.error.isEmpty() ? QStringLiteral("Unreadable export.pdb") : document.error;
+            return false;
+        }
+        const auto tracks = rekordbox::readTrackIndex(document);
+        for (const auto& track : tracks.tracks) {
+            if (!m_started) return false;
+            QString analysis = track.analysisPath;
+            while (analysis.startsWith(QLatin1Char('/'))) analysis.remove(0, 1);
+            if (analysis.isEmpty() || analysis.contains(QStringLiteral(".."))) continue;
+            const QString base = analysis.left(analysis.lastIndexOf(QLatin1Char('.')));
+            for (const char* extension : {".DAT", ".EXT", ".2EX"}) {
+                QString skipped;
+                fetchPioneerFile(nfs, source, base + QLatin1String(extension), &skipped); // best effort
+            }
+        }
+        return true;
+    }
+
+    bool ensurePioneer(const NetSource& source, const QString& relativePath, QString* error) {
+        QString clean = relativePath;
+        clean.replace(QLatin1Char('\\'), QLatin1Char('/'));
+        while (clean.startsWith(QLatin1Char('/'))) clean.remove(0, 1);
+        if (clean.isEmpty() || clean.contains(QStringLiteral(".."))) {
+            if (error) *error = QStringLiteral("Bad path");
+            return false;
+        }
+        const QString target = QDir(source.root).filePath(clean);
+        const auto fileLock = pathLock(target);
+        QMutexLocker lock(fileLock.get());
+        const QFileInfo existing(target);
+        if (existing.isFile() && existing.size() > 0) return true;
+        NfsClient nfs(source.host, 3000);
+        if (!nfs.mount(source.mountPath)) {
+            if (error) *error = nfs.error();
+            return false;
+        }
+        return fetchPioneerFile(nfs, source, clean, error);
+    }
+
+    // A peer was heard (announcement or manual poll).
+    void seen(const QString& id, const QString& name, const QString& host, quint16 port, bool auth, bool manual) {
+        const QString key = QStringLiteral("nautic-") + nmxSanitize(id, QStringLiteral("peer"));
+        bool created = false;
+        {
+            QMutexLocker lock(&m_mutex);
+            auto it = m_sources.find(key);
+            if (it == m_sources.end()) {
+                NetSource source;
+                source.key = key;
+                source.protocol = Protocol::Nautic;
+                source.root = QDir(m_cacheBase).filePath(key);
+                source.state = QStringLiteral("preparing");
+                it = m_sources.insert(key, source);
+                created = true;
+            }
+            it->name = name.isEmpty() ? host : name;
+            it->host = host;
+            it->port = port;
+            it->auth = auth;
+            it->manual = manual;
+            it->lastSeenMs = QDateTime::currentMSecsSinceEpoch();
+        }
+        if (created) {
+            notifyChanged();
+            startSync(key);
+        }
+    }
+
+    void tick() {
+        const qint64 now = QDateTime::currentMSecsSinceEpoch();
+        QStringList gone, retry;
+        {
+            QMutexLocker lock(&m_mutex);
+            for (auto& source : m_sources) {
+                if (source.protocol == Protocol::Pioneer) {
+                    if (now - source.lastSeenMs > 10000) gone.append(source.key);
+                    continue;
+                }
+                if (now - source.lastSeenMs > 12000) gone.append(source.key);
+                else if (source.state == QLatin1String("error") && now - source.lastAttemptMs > 20000) retry.append(source.key);
+            }
+        }
+        for (const auto& key : std::as_const(gone)) removeSource(key);
+        for (const auto& key : std::as_const(retry)) refresh(key);
+        pollManualHosts();
+        if (extraTick) extraTick();
+    }
+
+    // `[RX3Network] hosts`: "192.168.1.20,studio.local:48210" for networks that do not forward broadcasts.
+    void pollManualHosts() {
+        const QStringList hosts = m_config->getValueString(ConfigKey("[RX3Network]", "hosts"))
+                                          .split(QLatin1Char(','), Qt::SkipEmptyParts);
+        for (const QString& entry : hosts) {
+            const QString trimmed = entry.trimmed();
+            QString host = trimmed;
+            quint16 port = kNmxPort;
+            const int colon = trimmed.lastIndexOf(QLatin1Char(':'));
+            if (colon > 0) {
+                host = trimmed.left(colon);
+                port = quint16(trimmed.mid(colon + 1).toUInt());
+            }
+            if (host.isEmpty() || m_polling.contains(trimmed)) continue;
+            m_polling.insert(trimmed);
+            const QString pinValue = pin();
+            (void)QtConcurrent::run([this, trimmed, host, port, pinValue] {
+                HttpResponse response;
+                const QByteArray path = "/nmx/v1/info";
+                const bool ok = httpGet(host, port, path, nmxAuthHeaders(pinValue, path), nullptr, &response, 2500);
+                QMetaObject::invokeMethod(this, [this, trimmed, host, port, ok, response] {
+                    m_polling.remove(trimmed);
+                    if (!ok && response.status != 401) return;
+                    const QJsonObject json = QJsonDocument::fromJson(response.body).object();
+                    const QString id = json.value("id").toString();
+                    if (ok && !id.isEmpty() && id != m_ownId)
+                        seen(id, json.value("name").toString(), host, port, json.value("auth").toBool(), true);
+                }, Qt::QueuedConnection);
+            });
+        }
+    }
+
+    // Library snapshot + summaries, then publish as ready.
+    void startSync(const QString& key) {
+        NetSource source;
+        {
+            QMutexLocker lock(&m_mutex);
+            auto it = m_sources.find(key);
+            if (it == m_sources.end()) return;
+            if (it->state == QLatin1String("syncing")) return;
+            it->lastAttemptMs = QDateTime::currentMSecsSinceEpoch();
+            source = *it;
+        }
+        const QString pinValue = pin();
+        (void)QtConcurrent::run([this, source, pinValue] {
+            QString error;
+            const bool ok = syncNautic(source, pinValue, &error);
+            QMetaObject::invokeMethod(this, [this, key = source.key, ok, error] {
+                updateSource(key, [&](NetSource& s) {
+                    s.state = ok ? QStringLiteral("ready") : QStringLiteral("error");
+                    s.error = error;
+                    ++s.generation;
+                });
+            }, Qt::QueuedConnection);
+        });
+    }
+
+    bool syncNautic(const NetSource& source, const QString& pinValue, QString* error) {
+        const auto get = [&](const QByteArray& path, QIODevice* sink, HttpResponse* response, int timeout) {
+            return httpGet(source.host, source.port, path, nmxAuthHeaders(pinValue, path), sink, response, timeout);
+        };
+        HttpResponse info;
+        if (!get("/nmx/v1/info", nullptr, &info, 5000)) {
+            *error = info.status == 401 ? QStringLiteral("PIN required or wrong") : info.error;
+            return false;
+        }
+        QDir().mkpath(QDir(source.root).filePath(QStringLiteral("MIXMAN/analysis")));
+        const QString database = QDir(source.root).filePath(QStringLiteral("MIXMAN/library.sqlite"));
+        {
+            QFile part(database + QStringLiteral(".part"));
+            if (!part.open(QIODevice::WriteOnly | QIODevice::Truncate)) {
+                *error = QStringLiteral("Cannot write the cache");
+                return false;
+            }
+            HttpResponse library;
+            if (!get("/nmx/v1/library", &part, &library, 60000)) {
+                *error = library.error;
+                return false;
+            }
+        }
+        HttpResponse summaries;
+        if (get("/nmx/v1/summaries", nullptr, &summaries, 60000)) {
+            const QByteArray& data = summaries.body;
+            int offset = 0;
+            while (offset + 8 <= data.size()) {
+                const quint32 id = qFromBigEndian<quint32>(data.constData() + offset);
+                const quint32 length = qFromBigEndian<quint32>(data.constData() + offset + 4);
+                offset += 8;
+                if (qint64(offset) + length > data.size()) break;
+                QFile out(QDir(source.root).filePath(QStringLiteral("MIXMAN/analysis/") + QString::number(id)));
+                if (out.open(QIODevice::WriteOnly | QIODevice::Truncate)) out.write(data.constData() + offset, length);
+                offset += int(length);
+            }
+        }
+        // rel path -> (track id, size), for on-demand audio.
+        QHash<QString, QPair<qint64, qint64>> files;
+        {
+            const QString connection = QStringLiteral("nmx-index-") + QUuid::createUuid().toString(QUuid::WithoutBraces);
+            {
+                QSqlDatabase db = QSqlDatabase::addDatabase(QStringLiteral("QSQLITE"), connection);
+                db.setDatabaseName(database + QStringLiteral(".part"));
+                db.setConnectOptions(QStringLiteral("QSQLITE_OPEN_READONLY"));
+                if (db.open()) {
+                    QSqlQuery q(db);
+                    if (q.exec(QStringLiteral("SELECT l.id, tl.location, tl.filesize FROM library l "
+                                              "JOIN track_locations tl ON tl.id = l.location"))) {
+                        while (q.next()) files.insert(q.value(1).toString(), {q.value(0).toLongLong(), q.value(2).toLongLong()});
+                    }
+                    db.close();
+                }
+            }
+            QSqlDatabase::removeDatabase(connection);
+        }
+        if (files.isEmpty()) {
+            // An empty share is still a valid, browsable (empty) source.
+        }
+        {
+            QMutexLocker lock(&m_filesMutex);
+            m_files.insert(source.key, files);
+        }
+        QFile::remove(database);
+        if (!QFile::rename(database + QStringLiteral(".part"), database)) {
+            *error = QStringLiteral("Cannot publish the cache");
+            return false;
+        }
+        return true;
+    }
+
+    bool ensureNautic(const NetSource& source, const QString& relativePath, QString* error) {
+        // Waveform analysis files are addressed by id.
+        QString clean = relativePath;
+        clean.replace(QLatin1Char('\\'), QLatin1Char('/'));
+        if (clean.contains(QStringLiteral("..")) || clean.isEmpty()) {
+            if (error) *error = QStringLiteral("Bad path");
+            return false;
+        }
+        QByteArray url;
+        qint64 expected = -1;
+        if (clean.startsWith(QStringLiteral("MIXMAN/analysis/"))) {
+            bool numeric = false;
+            clean.mid(QStringLiteral("MIXMAN/analysis/").size()).toLongLong(&numeric);
+            if (!numeric) { if (error) *error = QStringLiteral("Bad analysis path"); return false; }
+            url = "/nmx/v1/analysis/" + clean.mid(QStringLiteral("MIXMAN/analysis/").size()).toUtf8();
+        } else {
+            QPair<qint64, qint64> entry{-1, -1};
+            {
+                QMutexLocker lock(&m_filesMutex);
+                const auto files = m_files.value(source.key);
+                const auto it = files.constFind(clean);
+                if (it != files.cend()) entry = *it;
+            }
+            if (entry.first < 0) { if (error) *error = QStringLiteral("Unknown file"); return false; }
+            url = "/nmx/v1/audio/" + QByteArray::number(entry.first);
+            expected = entry.second;
+        }
+        const QString target = QDir(source.root).filePath(clean);
+        const auto fileLock = pathLock(target);
+        QMutexLocker lock(fileLock.get());
+        const QFileInfo existing(target);
+        if (existing.isFile() && existing.size() > 0 && (expected < 0 || existing.size() == expected)) return true;
+        QDir().mkpath(existing.absolutePath());
+        QFile part(target + QStringLiteral(".part"));
+        if (!part.open(QIODevice::WriteOnly | QIODevice::Truncate)) {
+            if (error) *error = QStringLiteral("Cannot write the cache");
+            return false;
+        }
+        HttpResponse response;
+        const QString pinValue = pin();
+        if (!httpGet(source.host, source.port, url, nmxAuthHeaders(pinValue, url), &part, &response, 20000)) {
+            part.close();
+            part.remove();
+            if (error) *error = response.error;
+            return false;
+        }
+        part.close();
+        QFile::remove(target);
+        if (!QFile::rename(part.fileName(), target)) {
+            if (error) *error = QStringLiteral("Cannot publish the cached file");
+            return false;
+        }
+        return true;
+    }
+
+    std::shared_ptr<QMutex> pathLock(const QString& path) {
+        QMutexLocker lock(&m_lockMutex);
+        auto& slot = m_pathLocks[path];
+        if (!slot) slot = std::make_shared<QMutex>();
+        return slot;
+    }
+
+    UserSettingsPointer m_config;
+    QString m_cacheBase, m_ownId, m_shareError;
+    mutable QMutex m_mutex;
+    QHash<QString, NetSource> m_sources;
+    QMutex m_filesMutex, m_lockMutex;
+    QHash<QString, QHash<QString, QPair<qint64, qint64>>> m_files;
+    QHash<QString, std::shared_ptr<QMutex>> m_pathLocks;
+    QSet<QString> m_polling;
+    struct PioneerProbe { bool busy{false}; qint64 lastMs{0}; };
+    QHash<QString, PioneerProbe> m_pioneerProbe;
+    std::unique_ptr<QUdpSocket> m_listen;
+    std::unique_ptr<QUdpSocket> m_prolink;
+    std::unique_ptr<QTimer> m_tick;
+    std::unique_ptr<NmxServer> m_share;
+    std::function<void()> m_changed;
+    bool m_started{false};
+    inline static NetworkManager* s_instance = nullptr;
+};
+
+} // namespace mixxx::network
diff --git a/b/src/library/network/nmxhttp.h b/src/library/network/nmxhttp.h
new file mode 100644
index 0000000..5fe2c83
--- /dev/null
+++ b/src/library/network/nmxhttp.h
@@ -0,0 +1,136 @@
+#pragma once
+
+// Tiny blocking HTTP/1.1 GET client for the NauticMixxx share protocol
+// ("NMX", see docs/NETWORK-SOURCE-2.4-EN.md). It runs on whatever thread calls
+// it (never the audio thread) and streams the body to a QIODevice, so a track
+// can be copied to the cache without holding it in memory.
+
+#include <QByteArray>
+#include <QCryptographicHash>
+#include <QDateTime>
+#include <QElapsedTimer>
+#include <QIODevice>
+#include <QList>
+#include <QMessageAuthenticationCode>
+#include <QPair>
+#include <QString>
+#include <QTcpSocket>
+
+#include <functional>
+
+namespace mixxx::network {
+
+constexpr quint16 kNmxPort = 48210;           // TCP: HTTP. UDP: announcements (kNmxPort + 1).
+constexpr quint16 kNmxAnnouncePort = 48211;
+constexpr int kNmxVersion = 1;
+
+struct HttpResponse {
+    int status{0};
+    qint64 contentLength{-1};
+    QByteArray body; // only when no sink was given
+    QString error;
+};
+
+// X-NMX-Sig = hex(HMAC-SHA256(pin, "GET\n<path>\n<unix time>")). With an empty PIN nothing is signed.
+inline QByteArray nmxSignature(const QString& pin, const QByteArray& method,
+        const QByteArray& path, const QByteArray& time) {
+    return QMessageAuthenticationCode::hash(QByteArray(method + '\n' + path + '\n' + time),
+            pin.toUtf8(), QCryptographicHash::Sha256).toHex();
+}
+
+inline QList<QPair<QByteArray, QByteArray>> nmxAuthHeaders(const QString& pin, const QByteArray& path) {
+    QList<QPair<QByteArray, QByteArray>> headers;
+    if (pin.isEmpty()) return headers;
+    const QByteArray time = QByteArray::number(QDateTime::currentSecsSinceEpoch());
+    headers.append({"X-NMX-Time", time});
+    headers.append({"X-NMX-Sig", nmxSignature(pin, "GET", path, time)});
+    return headers;
+}
+
+// Returns true when the server answered 200. `progress` may cancel by returning false.
+inline bool httpGet(const QString& host, quint16 port, const QByteArray& path,
+        const QList<QPair<QByteArray, QByteArray>>& headers, QIODevice* sink,
+        HttpResponse* out, int timeoutMs = 8000, qint64 maxBytes = Q_INT64_C(8) << 30,
+        const std::function<bool(qint64)>& progress = {}) {
+    HttpResponse local;
+    HttpResponse& response = out ? *out : local;
+    response = {};
+    QTcpSocket socket;
+    socket.connectToHost(host, port);
+    if (!socket.waitForConnected(timeoutMs)) {
+        response.error = QStringLiteral("Cannot connect to %1:%2").arg(host).arg(port);
+        return false;
+    }
+    QByteArray request = "GET " + path + " HTTP/1.1\r\nHost: " + host.toUtf8() + ':' +
+            QByteArray::number(port) + "\r\nConnection: close\r\nUser-Agent: NauticMixxx-NMX/1\r\n";
+    for (const auto& header : headers) request += header.first + ": " + header.second + "\r\n";
+    request += "\r\n";
+    socket.write(request);
+    if (!socket.waitForBytesWritten(timeoutMs)) {
+        response.error = QStringLiteral("Request not sent");
+        return false;
+    }
+    QByteArray buffer;
+    bool headerDone = false;
+    qint64 received = 0;
+    const auto consume = [&](const QByteArray& data) -> bool {
+        received += data.size();
+        if (received > maxBytes) { response.error = QStringLiteral("Response too large"); return false; }
+        if (sink) {
+            if (sink->write(data) != data.size()) { response.error = QStringLiteral("Cannot write the cache file"); return false; }
+        } else {
+            response.body += data;
+        }
+        if (progress && !progress(received)) { response.error = QStringLiteral("Cancelled"); return false; }
+        return true;
+    };
+    while (true) {
+        if (socket.bytesAvailable() == 0 && !socket.waitForReadyRead(timeoutMs)) {
+            if (socket.state() != QAbstractSocket::ConnectedState && headerDone) break; // closed
+            if (socket.state() == QAbstractSocket::ConnectedState) {
+                response.error = QStringLiteral("Timed out");
+                return false;
+            }
+            break;
+        }
+        const QByteArray chunk = socket.readAll();
+        if (!headerDone) {
+            buffer += chunk;
+            const int end = buffer.indexOf("\r\n\r\n");
+            if (end < 0) {
+                if (buffer.size() > 32768) { response.error = QStringLiteral("Bad response"); return false; }
+                continue;
+            }
+            const QList<QByteArray> lines = buffer.left(end).split('\n');
+            const QList<QByteArray> status = lines.value(0).trimmed().split(' ');
+            response.status = status.value(1).toInt();
+            for (int i = 1; i < lines.size(); ++i) {
+                const int colon = lines[i].indexOf(':');
+                if (colon > 0 && lines[i].left(colon).trimmed().toLower() == "content-length")
+                    response.contentLength = lines[i].mid(colon + 1).trimmed().toLongLong();
+            }
+            headerDone = true;
+            const QByteArray rest = buffer.mid(end + 4);
+            buffer.clear();
+            if (response.status != 200) {
+                response.error = QStringLiteral("HTTP %1").arg(response.status);
+                return false;
+            }
+            if (!rest.isEmpty() && !consume(rest)) return false;
+        } else if (!consume(chunk)) {
+            return false;
+        }
+        if (headerDone && response.contentLength >= 0 && received >= response.contentLength) break;
+    }
+    if (!headerDone) {
+        response.error = QStringLiteral("No response");
+        return false;
+    }
+    if (response.contentLength >= 0 && received < response.contentLength) {
+        response.error = QStringLiteral("Connection closed early");
+        return false;
+    }
+    return true;
+}
+
+} // namespace mixxx::network
diff --git a/b/src/library/network/nmxshare.h b/src/library/network/nmxshare.h
new file mode 100644
index 0000000..3542376
--- /dev/null
+++ b/src/library/network/nmxshare.h
@@ -0,0 +1,461 @@
+#pragma once
+
+// NauticMixxx share server (NMX v1): read-only access to this machine's STORAGE
+// library for other NauticMixxx instances. Nothing here can write or delete.
+//
+//   GET /nmx/v1/info        {"nmx":1,"id":...,"name":...,"auth":bool}
+//   GET /nmx/v1/library     a MIXMAN-format SQLite snapshot (tracks, cues, grids,
+//                           crates, playlists; audio paths relative to Contents/)
+//   GET /nmx/v1/summaries   all waveform summaries: repeated [u32 id][u32 len][bytes]
+//   GET /nmx/v1/analysis/N  one stored waveform analysis file
+//   GET /nmx/v1/audio/N     the audio file of library track N (Range not needed)
+//
+// Only files that belong to tracks of the snapshot are ever served, addressed by
+// track id, never by path. With a PIN every request must carry X-NMX-Time and
+// X-NMX-Sig (HMAC-SHA256, see nmxhttp.h). Sharing is off unless the user turns it on.
+
+#include <QDir>
+#include <QFile>
+#include <QFileInfo>
+#include <QHash>
+#include <QHostInfo>
+#include <QJsonDocument>
+#include <QJsonObject>
+#include <QMutex>
+#include <QMutexLocker>
+#include <QNetworkDatagram>
+#include <QNetworkInterface>
+#include <QRegularExpression>
+#include <QSet>
+#include <QSqlDatabase>
+#include <QSqlError>
+#include <QSqlQuery>
+#include <QTcpServer>
+#include <QThreadPool>
+#include <QTimer>
+#include <QUdpSocket>
+#include <QUuid>
+#include <QtEndian>
+
+#include <algorithm>
+#include <atomic>
+
+#include <memory>
+
+#include "library/network/nmxhttp.h"
+
+namespace mixxx::network {
+
+inline QString nmxSanitize(QString text, const QString& fallback) {
+    text.replace(QRegularExpression(QStringLiteral("[\\\\/:*?\"<>|\\x00-\\x1f]")), QStringLiteral("_"));
+    text = text.trimmed();
+    while (text.startsWith(QLatin1Char('.'))) text.remove(0, 1);
+    if (text.size() > 120) text = text.left(120);
+    return text.isEmpty() ? fallback : text;
+}
+
+// What the server knows about the last snapshot: which files belong to which id.
+struct NmxCatalog {
+    QMutex mutex;
+    QString settingsPath;
+    QString exportId;
+    QByteArray snapshot;            // the SQLite file
+    QByteArray summaries;           // bundled type-2 analyses
+    QHash<qint64, QString> audio;   // track id -> absolute file
+    QSet<qint64> analysisIds;
+    qint64 builtAtMs{0};
+    int tracks{0};
+};
+
+inline bool nmxBuildSnapshot(const QString& settingsPath, const QString& exportId,
+        QByteArray* file, QByteArray* summaries, QHash<qint64, QString>* audio,
+        QSet<qint64>* analysisIds, int* trackCount, QString* error) {
+    const QString source = QDir(settingsPath).filePath(QStringLiteral("mixxxdb.sqlite"));
+    if (!QFileInfo::exists(source)) {
+        if (error) *error = QStringLiteral("No library database");
+        return false;
+    }
+    const QString temp = QDir::temp().filePath(QStringLiteral("nmx-snapshot-") +
+            QUuid::createUuid().toString(QUuid::WithoutBraces) + QStringLiteral(".sqlite"));
+    const QString connection = QStringLiteral("nmx-snapshot-") + QUuid::createUuid().toString(QUuid::WithoutBraces);
+    QList<qint64> summaryIds;
+    bool ok = false;
+    {
+        QSqlDatabase db = QSqlDatabase::addDatabase(QStringLiteral("QSQLITE"), connection);
+        db.setDatabaseName(temp);
+        if (!db.open()) {
+            if (error) *error = db.lastError().text();
+        } else {
+            ok = [&]() -> bool {
+                QSqlQuery q(db);
+                const auto fail = [&](const QString& message) {
+                    if (error) *error = message;
+                    return false;
+                };
+                const auto exec = [&](const QString& sql) {
+                    if (!q.exec(sql)) {
+                        if (error) *error = q.lastError().text() + QStringLiteral(" in: ") + sql.left(80);
+                        return false;
+                    }
+                    return true;
+                };
+                static const QStringList ddl{
+                    "CREATE TABLE library(id INT,artist TEXT,title TEXT,album TEXT,year TEXT,genre TEXT,tracknumber TEXT,location INT,comment TEXT,url TEXT,duration REAL,bitrate INT,samplerate INT,cuepoint INT,bpm REAL,wavesummaryhex,channels INT,datetime_added,mixxx_deleted INT,played INT,header_parsed INT,filetype TEXT,replaygain REAL,timesplayed INT,rating INT,\"key\" TEXT,beats,beats_version TEXT,composer TEXT,bpm_lock INT,beats_sub_version TEXT,keys,keys_version TEXT,keys_sub_version TEXT,key_id INT,grouping TEXT,album_artist TEXT,color INT,last_played_at NUM)",
+                    "CREATE TABLE track_locations(id INT,location TEXT,filename TEXT,directory TEXT,filesize INT,fs_deleted INT,needs_verification INT)",
+                    "CREATE TABLE cues(id INT,track_id INT,type INT,position INT,length INT,hotcue INT,label TEXT,color INT)",
+                    "CREATE TABLE crates(id INT,name TEXT,count INT,show INT,locked INT,autodj_source INT)",
+                    "CREATE TABLE crate_tracks(crate_id INT,track_id INT)",
+                    "CREATE TABLE Playlists(id INT,name TEXT,position INT,hidden INT,date_created NUM,date_modified NUM,locked INT)",
+                    "CREATE TABLE PlaylistTracks(id INT,playlist_id INT,track_id INT,position INT,pl_datetime_added)",
+                    "CREATE TABLE track_analysis(id INT,track_id INT,type TEXT,description TEXT,version TEXT,created,data_checksum TEXT)",
+                    "CREATE TABLE meta(key TEXT PRIMARY KEY,value TEXT)",
+                    "CREATE TEMP TABLE sel(id INT PRIMARY KEY)"};
+                for (const auto& sql : ddl) if (!exec(sql)) return false;
+                q.prepare(QStringLiteral("ATTACH DATABASE ? AS src"));
+                q.addBindValue(source);
+                if (!q.exec()) { if (error) *error = q.lastError().text(); return false; }
+                if (!exec(QStringLiteral("BEGIN"))) return false;
+
+                QSqlQuery tracks(db);
+                if (!tracks.exec(QStringLiteral(
+                            "SELECT l.id, l.artist, tl.id, tl.location, tl.filename, tl.filesize "
+                            "FROM src.library l JOIN src.track_locations tl ON tl.id = l.location "
+                            "WHERE COALESCE(l.mixxx_deleted,0)=0 AND COALESCE(tl.fs_deleted,0)=0 ORDER BY l.id"))) {
+                    if (error) *error = tracks.lastError().text();
+                    return false;
+                }
+                QSet<QString> used;
+                QSqlQuery insertLocation(db), insertSel(db);
+                insertLocation.prepare(QStringLiteral("INSERT INTO track_locations VALUES(?,?,?,?,?,0,0)"));
+                insertSel.prepare(QStringLiteral("INSERT INTO sel VALUES(?)"));
+                int count = 0;
+                while (tracks.next()) {
+                    const qint64 id = tracks.value(0).toLongLong();
+                    const QString absolute = tracks.value(3).toString();
+                    if (id <= 0 || id > 0x7fffffffLL || !QFileInfo(absolute).isFile()) continue;
+                    const QString artist = nmxSanitize(tracks.value(1).toString(), QStringLiteral("Unknown Artist"));
+                    QString name = nmxSanitize(tracks.value(4).toString().isEmpty() ? QFileInfo(absolute).fileName() : tracks.value(4).toString(),
+                            QStringLiteral("track"));
+                    QString directory = QStringLiteral("MIXMAN/Contents/") + artist;
+                    QString relative = directory + QLatin1Char('/') + name;
+                    if (used.contains(relative.toLower())) {
+                        const QFileInfo info(name);
+                        name = info.completeBaseName() + QStringLiteral(" (") + QString::number(id) + QStringLiteral(")") +
+                                (info.suffix().isEmpty() ? QString() : QStringLiteral(".") + info.suffix());
+                        relative = directory + QLatin1Char('/') + name;
+                    }
+                    used.insert(relative.toLower());
+                    insertLocation.addBindValue(tracks.value(2));
+                    insertLocation.addBindValue(relative);
+                    insertLocation.addBindValue(name);
+                    insertLocation.addBindValue(directory);
+                    insertLocation.addBindValue(QFileInfo(absolute).size());
+                    if (!insertLocation.exec()) return fail(insertLocation.lastError().text());
+                    insertSel.addBindValue(id);
+                    if (!insertSel.exec()) return fail(insertSel.lastError().text());
+                    (*audio)[id] = absolute;
+                    ++count;
+                }
+                const QString columns = QStringLiteral(
+                        "id,artist,title,album,year,genre,tracknumber,location,comment,url,duration,bitrate,samplerate,"
+                        "cuepoint,bpm,wavesummaryhex,channels,datetime_added,mixxx_deleted,played,header_parsed,filetype,"
+                        "replaygain,timesplayed,rating,\"key\",beats,beats_version,composer,bpm_lock,beats_sub_version,"
+                        "keys,keys_version,keys_sub_version,key_id,grouping,album_artist,color,last_played_at");
+                for (const auto& sql : QStringList{
+                             QStringLiteral("INSERT INTO library(%1) SELECT %1 FROM src.library WHERE id IN (SELECT id FROM sel)").arg(columns),
+                             QStringLiteral("INSERT INTO cues SELECT id,track_id,type,position,length,hotcue,label,color FROM src.cues WHERE track_id IN (SELECT id FROM sel)"),
+                             QStringLiteral("INSERT INTO crates SELECT id,name,count,show,locked,autodj_source FROM src.crates WHERE COALESCE(show,1)=1"),
+                             QStringLiteral("INSERT INTO crate_tracks SELECT crate_id,track_id FROM src.crate_tracks WHERE track_id IN (SELECT id FROM sel)"),
+                             QStringLiteral("INSERT INTO Playlists SELECT id,name,position,hidden,date_created,date_modified,locked FROM src.Playlists WHERE COALESCE(hidden,0)=0"),
+                             QStringLiteral("INSERT INTO PlaylistTracks SELECT id,playlist_id,track_id,position,pl_datetime_added FROM src.PlaylistTracks WHERE track_id IN (SELECT id FROM sel) AND playlist_id IN (SELECT id FROM Playlists)"),
+                             QStringLiteral("INSERT INTO track_analysis SELECT id,track_id,type,description,version,created,data_checksum FROM src.track_analysis WHERE type IN (1,2) AND track_id IN (SELECT id FROM sel)")}) {
+                    if (!exec(sql)) return false;
+                }
+                q.prepare(QStringLiteral("INSERT INTO meta VALUES(?,?)"));
+                const QList<QPair<QString, QString>> meta{{"format", "mixman-export"}, {"format_version", "1"},
+                        {"mixxx_schema_version", "40"}, {"created_unix", QString::number(QDateTime::currentSecsSinceEpoch())},
+                        {"export_id", exportId}, {"app_version", "nauticmixxx-nmx1"}};
+                for (const auto& item : meta) {
+                    q.addBindValue(item.first);
+                    q.addBindValue(item.second);
+                    if (!q.exec()) return fail(q.lastError().text());
+                }
+                if (!exec(QStringLiteral("COMMIT"))) return false;
+                QSqlQuery analysis(db);
+                if (analysis.exec(QStringLiteral("SELECT id, CAST(type AS INTEGER) FROM track_analysis"))) {
+                    while (analysis.next()) {
+                        analysisIds->insert(analysis.value(0).toLongLong());
+                        if (analysis.value(1).toInt() == 2) summaryIds.append(analysis.value(0).toLongLong());
+                    }
+                }
+                *trackCount = count;
+                exec(QStringLiteral("DETACH DATABASE src"));
+                return true;
+            }();
+            db.close();
+        }
+    }
+    QSqlDatabase::removeDatabase(connection);
+    if (ok) {
+        QFile out(temp);
+        if (out.open(QIODevice::ReadOnly)) *file = out.readAll();
+        else { ok = false; if (error) *error = QStringLiteral("Cannot read the snapshot"); }
+    }
+    QFile::remove(temp);
+    QFile::remove(temp + QStringLiteral("-journal"));
+    if (ok) {
+        // Summaries: every type-2 analysis file, bundled as [u32 id][u32 length][bytes].
+        for (const qint64 id : std::as_const(summaryIds)) {
+            QFile analysisFile(QDir(settingsPath).filePath(QStringLiteral("analysis/") + QString::number(id)));
+            if (!analysisFile.open(QIODevice::ReadOnly) || analysisFile.size() > 8 * 1024 * 1024) continue;
+            const QByteArray data = analysisFile.readAll();
+            QByteArray head(8, 0);
+            qToBigEndian<quint32>(quint32(id), head.data());
+            qToBigEndian<quint32>(quint32(data.size()), head.data() + 4);
+            *summaries += head + data;
+        }
+    }
+    return ok;
+}
+
+
+// Shared state of one running share.
+class NmxServer {
+  public:
+    explicit NmxServer(QString settingsPath)
+            : m_catalog(std::make_shared<NmxCatalog>()) {
+        m_catalog->settingsPath = std::move(settingsPath);
+        m_pool.setMaxThreadCount(6);
+    }
+    ~NmxServer() { stop(); }
+    NmxServer(const NmxServer&) = delete;
+    NmxServer& operator=(const NmxServer&) = delete;
+
+    bool running() const { return m_listener && m_listener->isListening(); }
+    quint16 port() const { return m_listener ? m_listener->serverPort() : 0; }
+    const QString& id() const { return m_id; }
+
+    // GUI thread. `id` is stable per installation.
+    bool start(const QString& id, const QString& name, const QString& pin,
+            quint16 portNumber, QString* error) {
+        stop();
+        m_id = id;
+        m_name = name;
+        m_pin = pin;
+        m_stopping = false;
+        m_listener = std::make_unique<Listener>(this);
+        if (!m_listener->listen(QHostAddress::Any, portNumber)) {
+            if (error) *error = m_listener->errorString();
+            m_listener.reset();
+            return false;
+        }
+        m_socket = std::make_unique<QUdpSocket>();
+        m_timer = std::make_unique<QTimer>();
+        m_timer->setInterval(2000);
+        QObject::connect(m_timer.get(), &QTimer::timeout, m_timer.get(), [this] { announce(); });
+        m_timer->start();
+        announce();
+        return true;
+    }
+
+    void stop() {
+        m_stopping = true;
+        m_timer.reset();
+        m_socket.reset();
+        if (m_listener) m_listener->close();
+        m_pool.waitForDone(6000);
+        m_listener.reset();
+        QMutexLocker lock(&m_catalog->mutex);
+        m_catalog->snapshot.clear();
+        m_catalog->summaries.clear();
+        m_catalog->audio.clear();
+        m_catalog->analysisIds.clear();
+        m_catalog->builtAtMs = 0;
+    }
+
+  private:
+    class Listener final : public QTcpServer {
+      public:
+        explicit Listener(NmxServer* owner) : m_owner(owner) {}
+      protected:
+        void incomingConnection(qintptr descriptor) override { m_owner->accept(descriptor); }
+      private:
+        NmxServer* m_owner;
+    };
+
+    void announce() {
+        if (!m_socket || !m_listener) return;
+        const QByteArray datagram = QJsonDocument(QJsonObject{
+                {"nmx", kNmxVersion}, {"id", m_id}, {"name", m_name},
+                {"port", int(m_listener->serverPort())}, {"auth", !m_pin.isEmpty()}}).toJson(QJsonDocument::Compact);
+        QSet<QString> sent;
+        const auto send = [&](const QHostAddress& address) {
+            if (sent.contains(address.toString())) return;
+            sent.insert(address.toString());
+            m_socket->writeDatagram(datagram, address, kNmxAnnouncePort);
+        };
+        send(QHostAddress::Broadcast);
+        send(QHostAddress(QHostAddress::LocalHost));
+        for (const auto& interface : QNetworkInterface::allInterfaces()) {
+            if (!(interface.flags() & QNetworkInterface::IsUp) || !(interface.flags() & QNetworkInterface::CanBroadcast)) continue;
+            for (const auto& entry : interface.addressEntries()) {
+                if (!entry.broadcast().isNull()) send(entry.broadcast());
+            }
+        }
+    }
+
+    void accept(qintptr descriptor) {
+        if (m_stopping) {
+            QTcpSocket reject;
+            reject.setSocketDescriptor(descriptor);
+            return;
+        }
+        m_pool.start([this, descriptor] { serve(descriptor); });
+    }
+
+    // Flush everything and close properly; a QTcpSocket destroyed with queued data drops it.
+    static void finish(QTcpSocket& socket) {
+        while (socket.bytesToWrite() > 0 && socket.state() == QAbstractSocket::ConnectedState &&
+                socket.waitForBytesWritten(15000)) {
+        }
+        socket.disconnectFromHost();
+        if (socket.state() != QAbstractSocket::UnconnectedState) socket.waitForDisconnected(5000);
+    }
+
+    static void respond(QTcpSocket& socket, int status, const QByteArray& reason,
+            const QByteArray& type, const QByteArray& body) {
+        QByteArray head = "HTTP/1.1 " + QByteArray::number(status) + ' ' + reason +
+                "\r\nContent-Type: " + type + "\r\nContent-Length: " + QByteArray::number(body.size()) +
+                "\r\nConnection: close\r\nCache-Control: no-store\r\n\r\n";
+        socket.write(head);
+        socket.write(body);
+        finish(socket);
+    }
+
+    bool authorized(const QHash<QByteArray, QByteArray>& headers, const QByteArray& path) const {
+        if (m_pin.isEmpty()) return true;
+        const QByteArray time = headers.value("x-nmx-time");
+        const QByteArray signature = headers.value("x-nmx-sig");
+        if (time.isEmpty() || signature.isEmpty()) return false;
+        const qint64 now = QDateTime::currentSecsSinceEpoch();
+        if (qAbs(now - time.toLongLong()) > 300) return false;
+        const QByteArray expected = nmxSignature(m_pin, "GET", path, time);
+        if (expected.size() != signature.size()) return false;
+        int diff = 0; // constant-time comparison
+        for (int i = 0; i < expected.size(); ++i) diff |= expected[i] ^ signature[i];
+        return diff == 0;
+    }
+
+    bool ensureSnapshot(bool force, QString* error) {
+        QMutexLocker lock(&m_catalog->mutex);
+        const qint64 now = QDateTime::currentMSecsSinceEpoch();
+        if (!force && !m_catalog->snapshot.isEmpty()) return true;
+        if (force && !m_catalog->snapshot.isEmpty() && now - m_catalog->builtAtMs < 4000) return true;
+        QByteArray file, summaries;
+        QHash<qint64, QString> audio;
+        QSet<qint64> analysis;
+        int tracks = 0;
+        if (!nmxBuildSnapshot(m_catalog->settingsPath, m_id, &file, &summaries, &audio, &analysis, &tracks, error)) return false;
+        m_catalog->snapshot = std::move(file);
+        m_catalog->summaries = std::move(summaries);
+        m_catalog->audio = std::move(audio);
+        m_catalog->analysisIds = std::move(analysis);
+        m_catalog->tracks = tracks;
+        m_catalog->builtAtMs = now;
+        return true;
+    }
+
+    void serve(qintptr descriptor) {
+        QTcpSocket socket;
+        if (!socket.setSocketDescriptor(descriptor)) return;
+        QByteArray buffer;
+        QElapsedTimer clock;
+        clock.start();
+        while (!buffer.contains("\r\n\r\n")) {
+            if (buffer.size() > 16384 || clock.elapsed() > 6000 || m_stopping) {
+                respond(socket, 400, "Bad Request", "text/plain", "bad request");
+                return;
+            }
+            if (!socket.waitForReadyRead(2000) && socket.state() != QAbstractSocket::ConnectedState) return;
+            buffer += socket.readAll();
+        }
+        const QList<QByteArray> lines = buffer.left(buffer.indexOf("\r\n\r\n")).split('\n');
+        const QList<QByteArray> request = lines.value(0).trimmed().split(' ');
+        QHash<QByteArray, QByteArray> headers;
+        for (int i = 1; i < lines.size(); ++i) {
+            const int colon = lines[i].indexOf(':');
+            if (colon > 0) headers.insert(lines[i].left(colon).trimmed().toLower(), lines[i].mid(colon + 1).trimmed());
+        }
+        if (request.size() < 2 || request[0] != "GET") {
+            respond(socket, 405, "Method Not Allowed", "text/plain", "read-only share");
+            return;
+        }
+        const QByteArray path = request[1].split('?').value(0);
+        if (!authorized(headers, path)) {
+            respond(socket, 401, "Unauthorized", "text/plain", "PIN required or wrong");
+            return;
+        }
+        const QByteArray prefix = "/nmx/v1/";
+        if (!path.startsWith(prefix)) {
+            respond(socket, 404, "Not Found", "text/plain", "not found");
+            return;
+        }
+        const QByteArray route = path.mid(prefix.size());
+        QString error;
+        if (route == "info") {
+            respond(socket, 200, "OK", "application/json", QJsonDocument(QJsonObject{
+                    {"nmx", kNmxVersion}, {"id", m_id}, {"name", m_name}, {"auth", !m_pin.isEmpty()}})
+                            .toJson(QJsonDocument::Compact));
+        } else if (route == "library" || route == "summaries") {
+            if (!ensureSnapshot(route == "library", &error)) {
+                respond(socket, 503, "Service Unavailable", "text/plain", error.toUtf8());
+                return;
+            }
+            QByteArray body;
+            {
+                QMutexLocker lock(&m_catalog->mutex);
+                body = route == "library" ? m_catalog->snapshot : m_catalog->summaries;
+            }
+            respond(socket, 200, "OK", "application/octet-stream", body);
+        } else if (route.startsWith("analysis/") || route.startsWith("audio/")) {
+            bool numeric = false;
+            const bool isAudio = route.startsWith("audio/");
+            const qint64 id = route.mid(isAudio ? 6 : 9).toLongLong(&numeric);
+            if (!numeric || id <= 0 || !ensureSnapshot(false, &error)) {
+                respond(socket, 404, "Not Found", "text/plain", "not found");
+                return;
+            }
+            QString file;
+            {
+                QMutexLocker lock(&m_catalog->mutex);
+                if (isAudio) file = m_catalog->audio.value(id);
+                else if (m_catalog->analysisIds.contains(id))
+                    file = QDir(m_catalog->settingsPath).filePath(QStringLiteral("analysis/") + QString::number(id));
+            }
+            QFile input(file);
+            if (file.isEmpty() || !input.open(QIODevice::ReadOnly)) {
+                respond(socket, 404, "Not Found", "text/plain", "not found");
+                return;
+            }
+            socket.write("HTTP/1.1 200 OK\r\nContent-Type: application/octet-stream\r\nContent-Length: " +
+                    QByteArray::number(input.size()) + "\r\nConnection: close\r\n\r\n");
+            while (!input.atEnd() && !m_stopping) {
+                socket.write(input.read(256 * 1024));
+                if (!socket.waitForBytesWritten(15000)) return;
+            }
+        } else {
+            respond(socket, 404, "Not Found", "text/plain", "not found");
+        }
+        finish(socket);
+    }
+
+    std::shared_ptr<NmxCatalog> m_catalog;
+    std::unique_ptr<Listener> m_listener;
+    std::unique_ptr<QUdpSocket> m_socket;
+    std::unique_ptr<QTimer> m_timer;
+    QThreadPool m_pool;
+    QString m_id, m_name, m_pin;
+    std::atomic<bool> m_stopping{false};
+};
+
+} // namespace mixxx::network
diff --git a/b/src/library/network/prolinkdiscovery.h b/src/library/network/prolinkdiscovery.h
new file mode 100644
index 0000000..ee723fd
--- /dev/null
+++ b/src/library/network/prolinkdiscovery.h
@@ -0,0 +1,60 @@
+#pragma once
+
+// Passive Pioneer "Pro DJ Link" discovery. CDJ/XDJ players and DJM mixers
+// broadcast a keep-alive on UDP 50000 every ~1.5 s:
+//
+//   0x00  "Qspt1WmJOL"            10-byte magic
+//   0x0a  0x06                    packet type: keep-alive
+//   0x0c  device name             20 bytes, NUL padded ("CDJ-3000", "XDJ-RX3"...)
+//   0x24  device number           1-6 players, 0x11 mixer, 0x21 rekordbox
+//   0x26  MAC address             6 bytes
+//   0x2c  IPv4 address            4 bytes
+//
+// This module only listens. It never announces itself, so it does not take a
+// player number on the Pro DJ Link network and cannot disturb a performance.
+// Reading a player's media (dbserver metadata + NFS file access) is not
+// implemented: a discovered player is listed so it is visible under NETWORK,
+// marked as not browsable.
+
+#include <QByteArray>
+#include <QHostAddress>
+#include <QString>
+#include <QStringList>
+
+#include <cstring>
+
+namespace mixxx::network {
+
+constexpr quint16 kProLinkPort = 50000;
+
+struct ProLinkDevice {
+    QString name;
+    int number{0};
+    QString mac;
+    QString host;
+    bool isPlayer() const { return number >= 1 && number <= 6; }
+};
+
+inline bool parseProLinkKeepAlive(const QByteArray& packet, ProLinkDevice* out) {
+    static const char kMagic[] = "Qspt1WmJOL";
+    if (packet.size() < 0x30 || std::memcmp(packet.constData(), kMagic, 10) != 0) return false;
+    if (quint8(packet[0x0a]) != 0x06) return false;
+    QByteArray name = packet.mid(0x0c, 20);
+    const int nul = name.indexOf('\0');
+    if (nul >= 0) name.truncate(nul);
+    const QString text = QString::fromLatin1(name).trimmed();
+    if (text.isEmpty()) return false;
+    ProLinkDevice device;
+    device.name = text;
+    device.number = quint8(packet[0x24]);
+    QStringList mac;
+    for (int i = 0; i < 6; ++i) mac.append(QStringLiteral("%1").arg(quint8(packet[0x26 + i]), 2, 16, QLatin1Char('0')));
+    device.mac = mac.join(QLatin1Char(':'));
+    device.host = QStringLiteral("%1.%2.%3.%4")
+                          .arg(quint8(packet[0x2c])).arg(quint8(packet[0x2d]))
+                          .arg(quint8(packet[0x2e])).arg(quint8(packet[0x2f]));
+    *out = device;
+    return true;
+}
+
+} // namespace mixxx::network
diff --git a/b/src/library/network/prolinknfs.h b/src/library/network/prolinknfs.h
new file mode 100644
index 0000000..34ef7fc
--- /dev/null
+++ b/src/library/network/prolinknfs.h
@@ -0,0 +1,245 @@
+#pragma once
+
+// Read-only NFS v2 client over UDP, enough to read a Pioneer player's media
+// the way Beat Link / Crate Digger do (Pro DJ Link players export their USB/SD
+// slot as NFS shares "/C/" (USB) and "/B/" (SD)):
+//
+//   portmapper (111)  GETPORT mountd v1 / nfs v2
+//   mountd            MNT "/C/"                -> 32-byte root file handle
+//   nfs               LOOKUP, READ             -> files, chunk by chunk
+//
+// Plain ONC RPC (RFC 5531) / XDR (RFC 4506) with AUTH_UNIX credentials. Blocking;
+// call it from a worker thread only. It never writes, creates or removes anything
+// on the player. NOT validated against real CDJ/XDJ hardware (see docs).
+
+#include <QByteArray>
+#include <QDeadlineTimer>
+#include <QElapsedTimer>
+#include <QFile>
+#include <QHostAddress>
+#include <QString>
+#include <QStringList>
+#include <QUdpSocket>
+#include <QtEndian>
+
+#include <functional>
+
+namespace mixxx::network {
+
+class NfsClient {
+  public:
+    explicit NfsClient(const QString& host, int timeoutMs = 1500)
+            : m_host(host), m_timeoutMs(timeoutMs) {}
+
+    QString error() const { return m_error; }
+
+    // Resolve ports and mount `exportPath` ("/C/"). Returns false (error()) if absent.
+    bool mount(const QString& exportPath) {
+        m_mountPort = getPort(100005, 1);
+        m_nfsPort = getPort(100003, 2);
+        if (!m_mountPort || !m_nfsPort) {
+            if (m_error.isEmpty()) m_error = QStringLiteral("NFS is not offered by the player");
+            return false;
+        }
+        for (const QString& candidate : {exportPath, exportPath.endsWith(QLatin1Char('/')) ? exportPath.chopped(1) : exportPath + QLatin1Char('/')}) {
+            QByteArray args;
+            putString(args, candidate);
+            QByteArray reply;
+            if (!call(m_mountPort, 100005, 1, 1, args, &reply)) continue;
+            Reader in(reply);
+            quint32 status = 0;
+            if (!in.u32(&status) || status != 0) { m_error = QStringLiteral("mount refused (%1)").arg(status); continue; }
+            const QByteArray handle = in.fixed(32);
+            if (handle.size() != 32) { m_error = QStringLiteral("bad mount reply"); continue; }
+            m_root = handle;
+            m_error.clear();
+            return true;
+        }
+        return false;
+    }
+
+    struct Attr { bool ok{false}; quint32 type{0}; quint32 size{0}; QByteArray handle; };
+
+    // Resolve "a/b/c.ext" below the mount point.
+    Attr lookupPath(const QString& relativePath) {
+        Attr attr;
+        QByteArray handle = m_root;
+        const QStringList parts = relativePath.split(QLatin1Char('/'), Qt::SkipEmptyParts);
+        if (handle.isEmpty() || parts.isEmpty()) { m_error = QStringLiteral("not mounted"); return attr; }
+        for (const QString& part : parts) {
+            if (part == QLatin1String("..") || part == QLatin1String(".")) { m_error = QStringLiteral("bad path"); return {}; }
+            QByteArray args;
+            args.append(handle);
+            putString(args, part);
+            QByteArray reply;
+            if (!call(m_nfsPort, 100003, 2, 4, args, &reply)) return {};
+            Reader in(reply);
+            quint32 status = 0;
+            if (!in.u32(&status)) { m_error = QStringLiteral("short reply"); return {}; }
+            if (status != 0) { m_error = QStringLiteral("nfs error %1").arg(status); return {}; }
+            const QByteArray next = in.fixed(32);
+            const QByteArray fattr = in.fixed(68);
+            if (next.size() != 32 || fattr.size() != 68) { m_error = QStringLiteral("short lookup reply"); return {}; }
+            handle = next;
+            attr.type = qFromBigEndian<quint32>(fattr.constData());
+            attr.size = qFromBigEndian<quint32>(fattr.constData() + 20);
+        }
+        attr.ok = true;
+        attr.handle = handle;
+        return attr;
+    }
+
+    // Copy a file to `sink`. `progress` may abort by returning false.
+    bool readFile(const QString& relativePath, QIODevice* sink, const std::function<bool()>& keepGoing = {}) {
+        const Attr attr = lookupPath(relativePath);
+        if (!attr.ok) return false;
+        if (attr.type != 1) { m_error = QStringLiteral("not a regular file"); return false; }
+        quint32 offset = 0;
+        while (offset < attr.size) {
+            if (keepGoing && !keepGoing()) { m_error = QStringLiteral("cancelled"); return false; }
+            const quint32 want = qMin<quint32>(m_chunk, attr.size - offset);
+            QByteArray args;
+            args.append(attr.handle);
+            putU32(args, offset);
+            putU32(args, want);
+            putU32(args, want); // totalcount (unused)
+            QByteArray reply;
+            if (!call(m_nfsPort, 100003, 2, 6, args, &reply)) {
+                if (m_lastWasTimeout && m_chunk > 512) { m_chunk /= 2; continue; }
+                return false;
+            }
+            Reader in(reply);
+            quint32 status = 0;
+            if (!in.u32(&status) || status != 0) { m_error = QStringLiteral("nfs read error %1").arg(status); return false; }
+            in.fixed(68);
+            const QByteArray data = in.opaque();
+            if (data.isEmpty()) { m_error = QStringLiteral("empty read"); return false; }
+            if (sink->write(data) != data.size()) { m_error = QStringLiteral("cannot write"); return false; }
+            offset += quint32(data.size());
+        }
+        return true;
+    }
+
+  private:
+    struct Reader {
+        explicit Reader(const QByteArray& b) : data(b) {}
+        bool u32(quint32* out) {
+            if (pos + 4 > data.size()) return false;
+            *out = qFromBigEndian<quint32>(data.constData() + pos);
+            pos += 4;
+            return true;
+        }
+        QByteArray fixed(int n) {
+            if (pos + n > data.size()) { pos = data.size(); return {}; }
+            const QByteArray out = data.mid(pos, n);
+            pos += n;
+            return out;
+        }
+        QByteArray opaque() {
+            quint32 n = 0;
+            if (!u32(&n) || n > quint32(data.size() - pos)) return {};
+            const QByteArray out = data.mid(pos, int(n));
+            pos += int((n + 3) & ~3u);
+            return out;
+        }
+        const QByteArray& data;
+        int pos{0};
+    };
+    static void putU32(QByteArray& out, quint32 value) {
+        char b[4];
+        qToBigEndian(value, b);
+        out.append(b, 4);
+    }
+    static void putString(QByteArray& out, const QString& s) {
+        const QByteArray u = s.toUtf8();
+        putU32(out, quint32(u.size()));
+        out.append(u);
+        out.append(QByteArray((4 - u.size() % 4) % 4, '\0'));
+    }
+
+    quint16 getPort(quint32 program, quint32 version) {
+        QByteArray args;
+        putU32(args, program);
+        putU32(args, version);
+        putU32(args, 17); // UDP
+        putU32(args, 0);
+        QByteArray reply;
+        if (!call(111, 100000, 2, 3, args, &reply, /*unixAuth=*/false)) return 0;
+        Reader in(reply);
+        quint32 port = 0;
+        if (!in.u32(&port) || port == 0 || port > 65535) {
+            m_error = QStringLiteral("program %1 not registered").arg(program);
+            return 0;
+        }
+        return quint16(port);
+    }
+
+    // One RPC round trip with retries. `reply` receives the procedure result body.
+    bool call(quint16 port, quint32 program, quint32 version, quint32 procedure,
+            const QByteArray& args, QByteArray* reply, bool unixAuth = true) {
+        QUdpSocket socket;
+        const quint32 xid = ++m_xid;
+        QByteArray message;
+        putU32(message, xid);
+        putU32(message, 0);  // CALL
+        putU32(message, 2);  // RPC version
+        putU32(message, program);
+        putU32(message, version);
+        putU32(message, procedure);
+        if (unixAuth) {
+            QByteArray credential;
+            putU32(credential, 0);                         // stamp
+            putString(credential, QStringLiteral("nauticmixxx"));
+            putU32(credential, 0);                         // uid
+            putU32(credential, 0);                         // gid
+            putU32(credential, 0);                         // no auxiliary gids
+            putU32(message, 1);                            // AUTH_UNIX
+            putU32(message, quint32(credential.size()));
+            message.append(credential);
+        } else {
+            putU32(message, 0);
+            putU32(message, 0);
+        }
+        putU32(message, 0);  // verifier: AUTH_NULL
+        putU32(message, 0);
+        message.append(args);
+        m_lastWasTimeout = false;
+        for (int attempt = 0; attempt < 3; ++attempt) {
+            if (socket.writeDatagram(message, QHostAddress(m_host), port) != message.size()) {
+                m_error = socket.errorString();
+                return false;
+            }
+            QDeadlineTimer deadline(m_timeoutMs);
+            while (!deadline.hasExpired()) {
+                if (!socket.waitForReadyRead(int(qMax<qint64>(1, deadline.remainingTime())))) break;
+                while (socket.hasPendingDatagrams()) {
+                    const QByteArray packet = socket.receiveDatagram().data();
+                    Reader in(packet);
+                    quint32 rxid = 0, type = 0, replyStatus = 0, verifierFlavor = 0, verifierLength = 0, acceptStatus = 0;
+                    if (!in.u32(&rxid) || rxid != xid) continue;
+                    if (!in.u32(&type) || type != 1 || !in.u32(&replyStatus)) continue;
+                    if (replyStatus != 0) { m_error = QStringLiteral("rpc call denied"); return false; }
+                    if (!in.u32(&verifierFlavor) || !in.u32(&verifierLength)) continue;
+                    in.fixed(int((verifierLength + 3) & ~3u));
+                    if (!in.u32(&acceptStatus)) continue;
+                    if (acceptStatus != 0) { m_error = QStringLiteral("rpc not accepted (%1)").arg(acceptStatus); return false; }
+                    *reply = packet.mid(in.pos);
+                    return true;
+                }
+            }
+        }
+        m_lastWasTimeout = true;
+        m_error = QStringLiteral("no answer from %1:%2").arg(m_host).arg(port);
+        return false;
+    }
+
+    QString m_host, m_error;
+    int m_timeoutMs;
+    quint16 m_mountPort{0}, m_nfsPort{0};
+    QByteArray m_root;
+    quint32 m_xid{0x4e415554}; // "NAUT"
+    quint32 m_chunk{8192};
+    bool m_lastWasTimeout{false};
+};
+
+} // namespace mixxx::network
