+// Index of the profile described by "WIDTHxHEIGHT" (also accepts "800 x 480",
+// "800X480", "800*480"); -1 when the text is not a known display profile.
+inline int profileIndexForResolution(const QString& text) {
+    static const QRegularExpression re(
+            QStringLiteral("^\\s*(\\d+)\\s*[xX*\\x{00D7}]\\s*(\\d+)\\s*$"));
+    const auto match = re.match(text);
+    if (!match.hasMatch()) return -1;
+    const int w = match.captured(1).toInt();
+    const int h = match.captured(2).toInt();
+    for (int i = 0; i < kProfileCount; ++i) {
+        if (kProfiles[i].width == w && kProfiles[i].height == h) return i;
+    }
+    return -1;
+}
+// "1280x800|800x600|..." for help and warning texts.
+inline QString profileLabels(const QString& separator = QStringLiteral("|")) {
+    QString out;
+    for (int i = 0; i < kProfileCount; ++i) {
+        if (i) out += separator;
+        out += QLatin1String(kProfiles[i].label);
+    }
+    return out;
+}
 inline bool isRx3Skin(const QString& skin) { return profileIndexForSkin(skin) >= 0; }
