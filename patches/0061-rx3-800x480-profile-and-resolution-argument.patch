+namespace {
+// --resolution WIDTHxHEIGHT (NauticMixxx): select the matching display
+// profile skin before the launch image and the skin are created. Same effect
+// as SCREEN in UTILITY > DISPLAY (skin + default for the next start).
+void applyCommandLineResolution(const UserSettingsPointer& pConfig) {
+    const QString requested = CmdlineArgs::Instance().getResolution();
+    if (requested.isEmpty()) {
+        return;
+    }
+    const int index = rx3ui::profileIndexForResolution(requested);
+    if (index < 0) {
+        qWarning() << "Unknown --resolution" << requested << "- supported:"
+                   << rx3ui::profileLabels(QStringLiteral(", "));
+        return;
+    }
+    const ConfigValue skin(QString::fromLatin1(rx3ui::kProfiles[index].skin));
+    pConfig->set(ConfigKey("[Config]", "ResizableSkin"), skin);
+    pConfig->set(ConfigKey("[Config]", "Skin"), skin);
+    pConfig->setValue(ConfigKey("[RX3Window]", "Resolution"), index);
+    qInfo() << "Resolution from command line:" << rx3ui::kProfiles[index].label;
+}
+} // namespace
