<Template>
  <WidgetGroup>
    <ObjectName>Overview</ObjectName>
    <Layout>vertical</Layout>
    <Size>0me,0me</Size>
    <Children>
      <WidgetGroup>
        <ObjectName>RX3PerformanceArea</ObjectName>
        <Layout>horizontal</Layout>
        <Size>0me,0me</Size>
        <Children>
          <WidgetGroup>
            <ObjectName>Waveforms</ObjectName>
            <Layout>stacked</Layout>
            <Size>0me,0me</Size>
            <Children>
              <WidgetGroup>
                <ObjectName>WaveformsContent</ObjectName>
                <Layout>horizontal</Layout>
                <Size>0me,0me</Size>
                <Children>
                  <WidgetGroup>
                    <ObjectName>WaveformDeckInfo</ObjectName>
                    <Layout>vertical</Layout>
                    <Size>116f,0me</Size>
                    <Children>
                      <Template src="skin:waveform_info.xml"><SetVariable name="channel">1</SetVariable></Template>
                      <Template src="skin:waveform_info.xml"><SetVariable name="channel">2</SetVariable></Template>
                    </Children>
                  </WidgetGroup>
                  
                  <WidgetGroup>
                    <ObjectName>WaveformSignals</ObjectName>
                    <Layout>stacked</Layout>
                    <Size>0me,0me</Size>
                    <Children>
                      <WidgetGroup>
                        <ObjectName>NauticBgLogoContainer</ObjectName>
                        <Layout>vertical</Layout>
                        <Size>0me,0me</Size>
                        <Children>
                          <Label>
                            <ObjectName>NauticBgLogo</ObjectName>
                            <Size>277f,101f</Size>
                            <SizePolicy>f,f</SizePolicy>
                          </Label>
                        </Children>
                      </WidgetGroup>
                      <WidgetGroup>
                        <ObjectName>WaveformSignalContent</ObjectName>
                        <Layout>vertical</Layout>
                        <Size>0me,0me</Size>
                        <Children>
                          <Template src="skin:waveform.xml"><SetVariable name="channel">1</SetVariable></Template>
                          <Template src="skin:waveform.xml"><SetVariable name="channel">2</SetVariable></Template>
                        </Children>
                      </WidgetGroup>
                    </Children>
                  </WidgetGroup>
                </Children>
              </WidgetGroup>
            </Children>
          </WidgetGroup>
          
          <WidgetGroup>
            <ObjectName>RX3WaveformRightGap</ObjectName>
            <Size>1f,0me</Size>
          </WidgetGroup>
          <WidgetGroup>
            <ObjectName>SidePanel_Container</ObjectName>
            <Layout>vertical</Layout>
            <Size>121f,0me</Size>
            <Children>
              <Template src="skin:beffect.xml" />
            </Children>
          </WidgetGroup>
        </Children>
      </WidgetGroup>

      
      <WidgetGroup>
        <ObjectName>RX3ModeStripContainer</ObjectName>
        <Layout>vertical</Layout>
        <Size>0me,65f</Size>
        <Children><Template src="skin:rx3_mode_strip.xml" /></Children>
      </WidgetGroup>

      <WidgetGroup>
        <ObjectName>Decks</ObjectName>
        <Layout>horizontal</Layout>
        <Size>0me,156f</Size>
        <Children>
          <Template src="skin:deck.xml">
            <SetVariable name="channel">1</SetVariable>
            <SetVariable name="ovh">46</SetVariable>
            <SetVariable name="ovwf">42</SetVariable>
          </Template>
          <Template src="skin:deck.xml">
            <SetVariable name="channel">2</SetVariable>
            <SetVariable name="ovh">46</SetVariable>
            <SetVariable name="ovwf">42</SetVariable>
          </Template>
        </Children>
      </WidgetGroup>
    </Children>
  </WidgetGroup>
</Template>